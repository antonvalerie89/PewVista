  "cache_version": 6,
  "book_number": 57,
  "source_kind": "ebible_html_zip",
  "source_name": "SBL Greek NT",
  "chapters": {
    "1": {
      "1": "\u03a0\u03b1\u1fe6\u03bb\u03bf\u03c2 \u03b4\u03ad\u03c3\u03bc\u03b9\u03bf\u03c2 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6 \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03ba\u03b1\u1f76 \u03a4\u03b9\u03bc\u03cc\u03b8\u03b5\u03bf\u03c2 \u1f41 \u1f00\u03b4\u03b5\u03bb\u03c6\u1f78\u03c2 \u03a6\u03b9\u03bb\u03ae\u03bc\u03bf\u03bd\u03b9 \u03c4\u1ff7 \u1f00\u03b3\u03b1\u03c0\u03b7\u03c4\u1ff7 \u03ba\u03b1\u1f76 \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u1ff7 \u1f21\u03bc\u1ff6\u03bd",
      "2": "\u03ba\u03b1\u1f76 \u1f08\u03c0\u03c6\u03af\u1fb3 \u03c4\u1fc7 \u2e00\u1f00\u03b4\u03b5\u03bb\u03c6\u1fc7 * \u1f00\u03b4\u03b5\u03bb\u03c6\u1fc7 WH Treg NA28 ] \u1f00\u03b3\u03b1\u03c0\u03b7\u03c4\u1fc7 RP \u03ba\u03b1\u1f76 \u1f08\u03c1\u03c7\u03af\u03c0\u03c0\u1ff3 \u03c4\u1ff7 \u03c3\u03c5\u03c3\u03c4\u03c1\u03b1\u03c4\u03b9\u03ce\u03c4\u1fc3 \u1f21\u03bc\u1ff6\u03bd \u03ba\u03b1\u1f76 \u03c4\u1fc7 \u03ba\u03b1\u03c4\u02bc \u03bf\u1f36\u03ba\u03cc\u03bd \u03c3\u03bf\u03c5 \u1f10\u03ba\u03ba\u03bb\u03b7\u03c3\u03af\u1fb3\u00b7",
      "3": "\u03c7\u03ac\u03c1\u03b9\u03c2 \u1f51\u03bc\u1fd6\u03bd \u03ba\u03b1\u1f76 \u03b5\u1f30\u03c1\u03ae\u03bd\u03b7 \u1f00\u03c0\u1f78 \u03b8\u03b5\u03bf\u1fe6 \u03c0\u03b1\u03c4\u03c1\u1f78\u03c2 \u1f21\u03bc\u1ff6\u03bd \u03ba\u03b1\u1f76 \u03ba\u03c5\u03c1\u03af\u03bf\u03c5 \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6.",
      "4": "\u0395\u1f50\u03c7\u03b1\u03c1\u03b9\u03c3\u03c4\u1ff6 \u03c4\u1ff7 \u03b8\u03b5\u1ff7 \u03bc\u03bf\u03c5 \u03c0\u03ac\u03bd\u03c4\u03bf\u03c4\u03b5 \u03bc\u03bd\u03b5\u03af\u03b1\u03bd \u03c3\u03bf\u03c5 \u03c0\u03bf\u03b9\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf\u03c2 \u1f10\u03c0\u1f76 \u03c4\u1ff6\u03bd \u03c0\u03c1\u03bf\u03c3\u03b5\u03c5\u03c7\u1ff6\u03bd \u03bc\u03bf\u03c5,",
      "5": "\u1f00\u03ba\u03bf\u03cd\u03c9\u03bd \u03c3\u03bf\u03c5 \u03c4\u1f74\u03bd \u1f00\u03b3\u03ac\u03c0\u03b7\u03bd \u03ba\u03b1\u1f76 \u03c4\u1f74\u03bd \u03c0\u03af\u03c3\u03c4\u03b9\u03bd \u1f23\u03bd \u1f14\u03c7\u03b5\u03b9\u03c2 \u2e00\u03c0\u03c1\u1f78\u03c2 \u2020 \u03c0\u03c1\u1f78\u03c2 NA28 RP ] \u03b5\u1f30\u03c2 WH Treg \u03c4\u1f78\u03bd \u03ba\u03cd\u03c1\u03b9\u03bf\u03bd \u1f38\u03b7\u03c3\u03bf\u1fe6\u03bd \u03ba\u03b1\u1f76 \u03b5\u1f30\u03c2 \u03c0\u03ac\u03bd\u03c4\u03b1\u03c2 \u03c4\u03bf\u1f7a\u03c2 \u1f01\u03b3\u03af\u03bf\u03c5\u03c2,",
      "6": "\u1f45\u03c0\u03c9\u03c2 \u1f21 \u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03af\u03b1 \u03c4\u1fc6\u03c2 \u03c0\u03af\u03c3\u03c4\u03b5\u03ce\u03c2 \u03c3\u03bf\u03c5 \u1f10\u03bd\u03b5\u03c1\u03b3\u1f74\u03c2 \u03b3\u03ad\u03bd\u03b7\u03c4\u03b1\u03b9 \u1f10\u03bd \u1f10\u03c0\u03b9\u03b3\u03bd\u03ce\u03c3\u03b5\u03b9 \u03c0\u03b1\u03bd\u03c4\u1f78\u03c2 \u1f00\u03b3\u03b1\u03b8\u03bf\u1fe6 \u2e00\u03c4\u03bf\u1fe6 \u2021 \u03c4\u03bf\u1fe6 WH NA28 RP ] \u2013 Treg \u1f10\u03bd \u1f21\u03bc\u1fd6\u03bd \u03b5\u1f30\u03c2 \u2e00\u03a7\u03c1\u03b9\u03c3\u03c4\u03cc\u03bd \u00a7 \u03a7\u03c1\u03b9\u03c3\u03c4\u03cc\u03bd WH Treg NA28 ] + \u1f38\u03b7\u03c3\u03bf\u1fe6\u03bd RP",
      "7": "\u2e00\u03c7\u03b1\u03c1\u1f70\u03bd * \u03c7\u03b1\u03c1\u1f70\u03bd WH Treg NA28 ] \u03a7\u03ac\u03c1\u03b9\u03bd RP \u03b3\u1f70\u03c1 \u2e02\u03c0\u03bf\u03bb\u03bb\u1f74\u03bd \u1f14\u03c3\u03c7\u03bf\u03bd \u2020 \u03c0\u03bf\u03bb\u03bb\u1f74\u03bd \u1f14\u03c3\u03c7\u03bf\u03bd WH Treg NA28 ] \u1f14\u03c7\u03bf\u03bc\u03b5\u03bd \u03c0\u03bf\u03bb\u03bb\u1f74\u03bd RP \u03ba\u03b1\u1f76 \u03c0\u03b1\u03c1\u03ac\u03ba\u03bb\u03b7\u03c3\u03b9\u03bd \u1f10\u03c0\u1f76 \u03c4\u1fc7 \u1f00\u03b3\u03ac\u03c0\u1fc3 \u03c3\u03bf\u03c5, \u1f45\u03c4\u03b9 \u03c4\u1f70 \u03c3\u03c0\u03bb\u03ac\u03b3\u03c7\u03bd\u03b1 \u03c4\u1ff6\u03bd \u1f01\u03b3\u03af\u03c9\u03bd \u1f00\u03bd\u03b1\u03c0\u03ad\u03c0\u03b1\u03c5\u03c4\u03b1\u03b9 \u03b4\u03b9\u1f70 \u03c3\u03bf\u1fe6, \u1f00\u03b4\u03b5\u03bb\u03c6\u03ad.",
      "8": "\u0394\u03b9\u03cc, \u03c0\u03bf\u03bb\u03bb\u1f74\u03bd \u1f10\u03bd \u03a7\u03c1\u03b9\u03c3\u03c4\u1ff7 \u03c0\u03b1\u03c1\u03c1\u03b7\u03c3\u03af\u03b1\u03bd \u1f14\u03c7\u03c9\u03bd \u1f10\u03c0\u03b9\u03c4\u03ac\u03c3\u03c3\u03b5\u03b9\u03bd \u03c3\u03bf\u03b9 \u03c4\u1f78 \u1f00\u03bd\u1fc6\u03ba\u03bf\u03bd,",
      "9": "\u03b4\u03b9\u1f70 \u03c4\u1f74\u03bd \u1f00\u03b3\u03ac\u03c0\u03b7\u03bd \u03bc\u1fb6\u03bb\u03bb\u03bf\u03bd \u03c0\u03b1\u03c1\u03b1\u03ba\u03b1\u03bb\u1ff6, \u03c4\u03bf\u03b9\u03bf\u1fe6\u03c4\u03bf\u03c2 \u1f62\u03bd \u1f61\u03c2 \u03a0\u03b1\u1fe6\u03bb\u03bf\u03c2 \u03c0\u03c1\u03b5\u03c3\u03b2\u03cd\u03c4\u03b7\u03c2 \u03bd\u03c5\u03bd\u1f76 \u03b4\u1f72 \u03ba\u03b1\u1f76 \u03b4\u03ad\u03c3\u03bc\u03b9\u03bf\u03c2 \u2e02\u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6 \u1f38\u03b7\u03c3\u03bf\u1fe6 \u2021 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6 \u1f38\u03b7\u03c3\u03bf\u1fe6 WH Treg NA28 ] \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6 RP \u2014",
      "10": "\u03c0\u03b1\u03c1\u03b1\u03ba\u03b1\u03bb\u1ff6 \u03c3\u03b5 \u03c0\u03b5\u03c1\u1f76 \u03c4\u03bf\u1fe6 \u1f10\u03bc\u03bf\u1fe6 \u03c4\u03ad\u03ba\u03bd\u03bf\u03c5, \u1f43\u03bd \u1f10\u03b3\u03ad\u03bd\u03bd\u03b7\u03c3\u03b1 \u1f10\u03bd \u03c4\u03bf\u1fd6\u03c2 \u2e00\u03b4\u03b5\u03c3\u03bc\u03bf\u1fd6\u03c2 \u00a7 \u03b4\u03b5\u03c3\u03bc\u03bf\u1fd6\u03c2 WH Treg NA28 ] + \u03bc\u03bf\u03c5 RP \u1f48\u03bd\u03ae\u03c3\u03b9\u03bc\u03bf\u03bd,",
      "11": "\u03c4\u03cc\u03bd \u03c0\u03bf\u03c4\u03ad \u03c3\u03bf\u03b9 \u1f04\u03c7\u03c1\u03b7\u03c3\u03c4\u03bf\u03bd \u03bd\u03c5\u03bd\u1f76 \u2e00\u03b4\u1f72 * \u03b4\u1f72 WH Treg RP ] + \u03ba\u03b1\u1f76 NA28 \u03c3\u03bf\u1f76 \u03ba\u03b1\u1f76 \u1f10\u03bc\u03bf\u1f76 \u03b5\u1f54\u03c7\u03c1\u03b7\u03c3\u03c4\u03bf\u03bd,",
      "12": "\u1f43\u03bd \u1f00\u03bd\u03ad\u03c0\u03b5\u03bc\u03c8\u03ac \u2e02\u03c3\u03bf\u03b9 \u03b1\u1f50\u03c4\u03cc\u03bd, \u03c4\u03bf\u1fe6\u03c4\u02bc \u1f14\u03c3\u03c4\u03b9\u03bd \u03c4\u1f70 \u1f10\u03bc\u1f70 \u03c3\u03c0\u03bb\u03ac\u03b3\u03c7\u03bd\u03b1 \u2020 \u03c3\u03bf\u03b9 \u03b1\u1f50\u03c4\u03cc\u03bd \u2026 \u03c3\u03c0\u03bb\u03ac\u03b3\u03c7\u03bd\u03b1 WH Treg NA28 ] \u03c3\u1f7a \u03b4\u1f72 \u03b1\u1f50\u03c4\u03cc\u03bd \u2026 \u03c3\u03c0\u03bb\u03ac\u03b3\u03c7\u03bd\u03b1 \u03c0\u03c1\u03bf\u03c3\u03bb\u03b1\u03b2\u03bf\u1fe6 RP \u00b7",
      "13": "\u1f43\u03bd \u1f10\u03b3\u1f7c \u1f10\u03b2\u03bf\u03c5\u03bb\u03cc\u03bc\u03b7\u03bd \u03c0\u03c1\u1f78\u03c2 \u1f10\u03bc\u03b1\u03c5\u03c4\u1f78\u03bd \u03ba\u03b1\u03c4\u03ad\u03c7\u03b5\u03b9\u03bd, \u1f35\u03bd\u03b1 \u1f51\u03c0\u1f72\u03c1 \u03c3\u03bf\u1fe6 \u2e02\u03bc\u03bf\u03b9 \u03b4\u03b9\u03b1\u03ba\u03bf\u03bd\u1fc7 \u2021 \u03bc\u03bf\u03b9 \u03b4\u03b9\u03b1\u03ba\u03bf\u03bd\u1fc7 WH Treg NA28 ] \u03b4\u03b9\u03b1\u03ba\u03bf\u03bd\u1fc7 \u03bc\u03bf\u03b9 RP \u1f10\u03bd \u03c4\u03bf\u1fd6\u03c2 \u03b4\u03b5\u03c3\u03bc\u03bf\u1fd6\u03c2 \u03c4\u03bf\u1fe6 \u03b5\u1f50\u03b1\u03b3\u03b3\u03b5\u03bb\u03af\u03bf\u03c5,",
      "14": "\u03c7\u03c9\u03c1\u1f76\u03c2 \u03b4\u1f72 \u03c4\u1fc6\u03c2 \u03c3\u1fc6\u03c2 \u03b3\u03bd\u03ce\u03bc\u03b7\u03c2 \u03bf\u1f50\u03b4\u1f72\u03bd \u1f20\u03b8\u03ad\u03bb\u03b7\u03c3\u03b1 \u03c0\u03bf\u03b9\u1fc6\u03c3\u03b1\u03b9, \u1f35\u03bd\u03b1 \u03bc\u1f74 \u1f61\u03c2 \u03ba\u03b1\u03c4\u1f70 \u1f00\u03bd\u03ac\u03b3\u03ba\u03b7\u03bd \u03c4\u1f78 \u1f00\u03b3\u03b1\u03b8\u03cc\u03bd \u03c3\u03bf\u03c5 \u1f96 \u1f00\u03bb\u03bb\u1f70 \u03ba\u03b1\u03c4\u1f70 \u1f11\u03ba\u03bf\u03cd\u03c3\u03b9\u03bf\u03bd\u00b7",
      "15": "\u03c4\u03ac\u03c7\u03b1 \u03b3\u1f70\u03c1 \u03b4\u03b9\u1f70 \u03c4\u03bf\u1fe6\u03c4\u03bf \u1f10\u03c7\u03c9\u03c1\u03af\u03c3\u03b8\u03b7 \u03c0\u03c1\u1f78\u03c2 \u1f65\u03c1\u03b1\u03bd \u1f35\u03bd\u03b1 \u03b1\u1f30\u03ce\u03bd\u03b9\u03bf\u03bd \u03b1\u1f50\u03c4\u1f78\u03bd \u1f00\u03c0\u03ad\u03c7\u1fc3\u03c2,",
      "16": "\u03bf\u1f50\u03ba\u03ad\u03c4\u03b9 \u1f61\u03c2 \u03b4\u03bf\u1fe6\u03bb\u03bf\u03bd \u1f00\u03bb\u03bb\u1f70 \u1f51\u03c0\u1f72\u03c1 \u03b4\u03bf\u1fe6\u03bb\u03bf\u03bd, \u1f00\u03b4\u03b5\u03bb\u03c6\u1f78\u03bd \u1f00\u03b3\u03b1\u03c0\u03b7\u03c4\u03cc\u03bd, \u03bc\u03ac\u03bb\u03b9\u03c3\u03c4\u03b1 \u1f10\u03bc\u03bf\u03af, \u03c0\u03cc\u03c3\u1ff3 \u03b4\u1f72 \u03bc\u1fb6\u03bb\u03bb\u03bf\u03bd \u03c3\u03bf\u1f76 \u03ba\u03b1\u1f76 \u1f10\u03bd \u03c3\u03b1\u03c1\u03ba\u1f76 \u03ba\u03b1\u1f76 \u1f10\u03bd \u03ba\u03c5\u03c1\u03af\u1ff3.",
      "17": "\u0395\u1f30 \u03bf\u1f56\u03bd \u03bc\u03b5 \u1f14\u03c7\u03b5\u03b9\u03c2 \u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03cc\u03bd, \u03c0\u03c1\u03bf\u03c3\u03bb\u03b1\u03b2\u03bf\u1fe6 \u03b1\u1f50\u03c4\u1f78\u03bd \u1f61\u03c2 \u1f10\u03bc\u03ad.",
      "18": "\u03b5\u1f30 \u03b4\u03ad \u03c4\u03b9 \u1f20\u03b4\u03af\u03ba\u03b7\u03c3\u03ad\u03bd \u03c3\u03b5 \u1f22 \u1f40\u03c6\u03b5\u03af\u03bb\u03b5\u03b9, \u03c4\u03bf\u1fe6\u03c4\u03bf \u1f10\u03bc\u03bf\u1f76 \u2e00\u1f10\u03bb\u03bb\u03cc\u03b3\u03b1 \u00a7 \u1f10\u03bb\u03bb\u03cc\u03b3\u03b1 WH Treg NA28 ] \u1f10\u03bb\u03bb\u03cc\u03b3\u03b5\u03b9 RP",
      "19": "\u1f10\u03b3\u1f7c \u03a0\u03b1\u1fe6\u03bb\u03bf\u03c2 \u1f14\u03b3\u03c1\u03b1\u03c8\u03b1 \u03c4\u1fc7 \u1f10\u03bc\u1fc7 \u03c7\u03b5\u03b9\u03c1\u03af, \u1f10\u03b3\u1f7c \u1f00\u03c0\u03bf\u03c4\u03af\u03c3\u03c9\u00b7 \u1f35\u03bd\u03b1 \u03bc\u1f74 \u03bb\u03ad\u03b3\u03c9 \u03c3\u03bf\u03b9 \u1f45\u03c4\u03b9 \u03ba\u03b1\u1f76 \u03c3\u03b5\u03b1\u03c5\u03c4\u03cc\u03bd \u03bc\u03bf\u03b9 \u03c0\u03c1\u03bf\u03c3\u03bf\u03c6\u03b5\u03af\u03bb\u03b5\u03b9\u03c2.",
      "20": "\u03bd\u03b1\u03af, \u1f00\u03b4\u03b5\u03bb\u03c6\u03ad, \u1f10\u03b3\u03ce \u03c3\u03bf\u03c5 \u1f40\u03bd\u03b1\u03af\u03bc\u03b7\u03bd \u1f10\u03bd \u03ba\u03c5\u03c1\u03af\u1ff3\u00b7 \u1f00\u03bd\u03ac\u03c0\u03b1\u03c5\u03c3\u03cc\u03bd \u03bc\u03bf\u03c5 \u03c4\u1f70 \u03c3\u03c0\u03bb\u03ac\u03b3\u03c7\u03bd\u03b1 \u1f10\u03bd \u2e00\u03a7\u03c1\u03b9\u03c3\u03c4\u1ff7 * \u03a7\u03c1\u03b9\u03c3\u03c4\u1ff7 WH Treg NA28 ] \u03ba\u03c5\u03c1\u03af\u1ff3 RP",
      "21": "\u03c0\u03b5\u03c0\u03bf\u03b9\u03b8\u1f7c\u03c2 \u03c4\u1fc7 \u1f51\u03c0\u03b1\u03ba\u03bf\u1fc7 \u03c3\u03bf\u03c5 \u1f14\u03b3\u03c1\u03b1\u03c8\u03ac \u03c3\u03bf\u03b9, \u03b5\u1f30\u03b4\u1f7c\u03c2 \u1f45\u03c4\u03b9 \u03ba\u03b1\u1f76 \u1f51\u03c0\u1f72\u03c1 \u2e00\u1f03 \u2020 \u1f03 WH Treg NA28 ] \u1f43 RP \u03bb\u03ad\u03b3\u03c9 \u03c0\u03bf\u03b9\u03ae\u03c3\u03b5\u03b9\u03c2.",
      "22": "\u1f05\u03bc\u03b1 \u03b4\u1f72 \u03ba\u03b1\u1f76 \u1f11\u03c4\u03bf\u03af\u03bc\u03b1\u03b6\u03ad \u03bc\u03bf\u03b9 \u03be\u03b5\u03bd\u03af\u03b1\u03bd, \u1f10\u03bb\u03c0\u03af\u03b6\u03c9 \u03b3\u1f70\u03c1 \u1f45\u03c4\u03b9 \u03b4\u03b9\u1f70 \u03c4\u1ff6\u03bd \u03c0\u03c1\u03bf\u03c3\u03b5\u03c5\u03c7\u1ff6\u03bd \u1f51\u03bc\u1ff6\u03bd \u03c7\u03b1\u03c1\u03b9\u03c3\u03b8\u03ae\u03c3\u03bf\u03bc\u03b1\u03b9 \u1f51\u03bc\u1fd6\u03bd.",
      "23": "\u2e00\u1f08\u03c3\u03c0\u03ac\u03b6\u03b5\u03c4\u03b1\u03af \u2021 \u1f08\u03c3\u03c0\u03ac\u03b6\u03b5\u03c4\u03b1\u03af WH Treg NA28 ] \u1f08\u03c3\u03c0\u03ac\u03b6\u03bf\u03bd\u03c4\u03b1\u03af RP \u03c3\u03b5 \u1f18\u03c0\u03b1\u03c6\u03c1\u1fb6\u03c2 \u1f41 \u03c3\u03c5\u03bd\u03b1\u03b9\u03c7\u03bc\u03ac\u03bb\u03c9\u03c4\u03cc\u03c2 \u03bc\u03bf\u03c5 \u1f10\u03bd \u03a7\u03c1\u03b9\u03c3\u03c4\u1ff7 \u1f38\u03b7\u03c3\u03bf\u1fe6,",
      "24": "\u039c\u1fb6\u03c1\u03ba\u03bf\u03c2, \u1f08\u03c1\u03af\u03c3\u03c4\u03b1\u03c1\u03c7\u03bf\u03c2, \u0394\u03b7\u03bc\u1fb6\u03c2, \u039b\u03bf\u03c5\u03ba\u1fb6\u03c2, \u03bf\u1f31 \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03bf\u03af \u03bc\u03bf\u03c5.",
      "25": "\u1f29 \u03c7\u03ac\u03c1\u03b9\u03c2 \u03c4\u03bf\u1fe6 \u2e00\u03ba\u03c5\u03c1\u03af\u03bf\u03c5 \u00a7 \u03ba\u03c5\u03c1\u03af\u03bf\u03c5 WH NA28 ] + \u1f21\u03bc\u1ff6\u03bd Treg RP \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6 \u03bc\u03b5\u03c4\u1f70 \u03c4\u03bf\u1fe6 \u03c0\u03bd\u03b5\u03cd\u03bc\u03b1\u03c4\u03bf\u03c2 \u2e00\u1f51\u03bc\u1ff6\u03bd * \u1f51\u03bc\u1ff6\u03bd WH Treg NA28 ] + \u1f08\u03bc\u03ae\u03bd RP \u2018p /\u2019 \u2018/book\u2019"
    }
  }
