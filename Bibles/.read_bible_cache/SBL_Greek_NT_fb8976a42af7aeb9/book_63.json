  "source_name": "SBL Greek NT",
  "chapters": {
    "1": {
      "1": "\u1f49 \u03c0\u03c1\u03b5\u03c3\u03b2\u03cd\u03c4\u03b5\u03c1\u03bf\u03c2 \u1f10\u03ba\u03bb\u03b5\u03ba\u03c4\u1fc7 \u03ba\u03c5\u03c1\u03af\u1fb3 \u03ba\u03b1\u1f76 \u03c4\u03bf\u1fd6\u03c2 \u03c4\u03ad\u03ba\u03bd\u03bf\u03b9\u03c2 \u03b1\u1f50\u03c4\u1fc6\u03c2, \u03bf\u1f53\u03c2 \u1f10\u03b3\u1f7c \u1f00\u03b3\u03b1\u03c0\u1ff6 \u1f10\u03bd \u1f00\u03bb\u03b7\u03b8\u03b5\u03af\u1fb3, \u03ba\u03b1\u1f76 \u03bf\u1f50\u03ba \u1f10\u03b3\u1f7c \u03bc\u03cc\u03bd\u03bf\u03c2 \u1f00\u03bb\u03bb\u1f70 \u03ba\u03b1\u1f76 \u03c0\u03ac\u03bd\u03c4\u03b5\u03c2 \u03bf\u1f31 \u1f10\u03b3\u03bd\u03c9\u03ba\u03cc\u03c4\u03b5\u03c2 \u03c4\u1f74\u03bd \u1f00\u03bb\u03ae\u03b8\u03b5\u03b9\u03b1\u03bd,",
      "2": "\u03b4\u03b9\u1f70 \u03c4\u1f74\u03bd \u1f00\u03bb\u03ae\u03b8\u03b5\u03b9\u03b1\u03bd \u03c4\u1f74\u03bd \u03bc\u03ad\u03bd\u03bf\u03c5\u03c3\u03b1\u03bd \u1f10\u03bd \u1f21\u03bc\u1fd6\u03bd, \u03ba\u03b1\u1f76 \u03bc\u03b5\u03b8\u02bc \u1f21\u03bc\u1ff6\u03bd \u1f14\u03c3\u03c4\u03b1\u03b9 \u03b5\u1f30\u03c2 \u03c4\u1f78\u03bd \u03b1\u1f30\u1ff6\u03bd\u03b1\u00b7",
      "3": "\u1f14\u03c3\u03c4\u03b1\u03b9 \u03bc\u03b5\u03b8\u02bc \u1f21\u03bc\u1ff6\u03bd \u03c7\u03ac\u03c1\u03b9\u03c2 \u1f14\u03bb\u03b5\u03bf\u03c2 \u03b5\u1f30\u03c1\u03ae\u03bd\u03b7 \u03c0\u03b1\u03c1\u1f70 * \u03c0\u03b1\u03c1\u1f70 WH Treg NA28 ] + \u03ba\u03c5\u03c1\u03af\u03bf\u03c5 RP \u03b8\u03b5\u03bf\u1fe6 \u03c0\u03b1\u03c4\u03c1\u03cc\u03c2, \u03ba\u03b1\u1f76 \u2e00\u03c0\u03b1\u03c1\u1f70 \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6 \u03c4\u03bf\u1fe6 \u03c5\u1f31\u03bf\u1fe6 \u03c4\u03bf\u1fe6 \u03c0\u03b1\u03c4\u03c1\u03cc\u03c2, \u1f10\u03bd \u1f00\u03bb\u03b7\u03b8\u03b5\u03af\u1fb3 \u03ba\u03b1\u1f76 \u1f00\u03b3\u03ac\u03c0\u1fc3.",
      "4": "\u1f18\u03c7\u03ac\u03c1\u03b7\u03bd \u03bb\u03af\u03b1\u03bd \u1f45\u03c4\u03b9 \u03b5\u1f55\u03c1\u03b7\u03ba\u03b1 \u1f10\u03ba \u03c4\u1ff6\u03bd \u03c4\u03ad\u03ba\u03bd\u03c9\u03bd \u03c3\u03bf\u03c5 \u03c0\u03b5\u03c1\u03b9\u03c0\u03b1\u03c4\u03bf\u1fe6\u03bd\u03c4\u03b1\u03c2 \u1f10\u03bd \u1f00\u03bb\u03b7\u03b8\u03b5\u03af\u1fb3, \u03ba\u03b1\u03b8\u1f7c\u03c2 \u1f10\u03bd\u03c4\u03bf\u03bb\u1f74\u03bd \u1f10\u03bb\u03ac\u03b2\u03bf\u03bc\u03b5\u03bd \u03c0\u03b1\u03c1\u1f70 \u03c4\u03bf\u1fe6 \u03c0\u03b1\u03c4\u03c1\u03cc\u03c2.",
      "5": "\u03ba\u03b1\u1f76 \u03bd\u1fe6\u03bd \u1f10\u03c1\u03c9\u03c4\u1ff6 \u03c3\u03b5, \u03ba\u03c5\u03c1\u03af\u03b1, \u03bf\u1f50\u03c7 \u1f61\u03c2 \u1f10\u03bd\u03c4\u03bf\u03bb\u1f74\u03bd \u2e02\u03ba\u03b1\u03b9\u03bd\u1f74\u03bd \u03b3\u03c1\u03ac\u03c6\u03c9\u03bd \u03c3\u03bf\u03b9 \u2020 \u03ba\u03b1\u03b9\u03bd\u1f74\u03bd \u03b3\u03c1\u03ac\u03c6\u03c9\u03bd \u03c3\u03bf\u03b9 Treg NA27 ] \u03b3\u03c1\u03ac\u03c6\u03c9\u03bd \u03c3\u03bf\u03b9 \u03ba\u03b1\u03b9\u03bd\u1f74\u03bd WH NA28 RP \u1f00\u03bb\u03bb\u1f70 \u1f23\u03bd \u03b5\u1f34\u03c7\u03bf\u03bc\u03b5\u03bd \u1f00\u03c0\u02bc \u1f00\u03c1\u03c7\u1fc6\u03c2, \u1f35\u03bd\u03b1 \u1f00\u03b3\u03b1\u03c0\u1ff6\u03bc\u03b5\u03bd \u1f00\u03bb\u03bb\u03ae\u03bb\u03bf\u03c5\u03c2.",
      "6": "\u03ba\u03b1\u1f76 \u03b1\u1f55\u03c4\u03b7 \u1f10\u03c3\u03c4\u1f76\u03bd \u1f21 \u1f00\u03b3\u03ac\u03c0\u03b7, \u1f35\u03bd\u03b1 \u03c0\u03b5\u03c1\u03b9\u03c0\u03b1\u03c4\u1ff6\u03bc\u03b5\u03bd \u03ba\u03b1\u03c4\u1f70 \u03c4\u1f70\u03c2 \u1f10\u03bd\u03c4\u03bf\u03bb\u1f70\u03c2 \u03b1\u1f50\u03c4\u03bf\u1fe6\u00b7 \u03b1\u1f55\u03c4\u03b7 \u2e02\u1f21 \u1f10\u03bd\u03c4\u03bf\u03bb\u03ae \u1f10\u03c3\u03c4\u03b9\u03bd \u2021 \u1f21 \u1f10\u03bd\u03c4\u03bf\u03bb\u03ae \u1f10\u03c3\u03c4\u03b9\u03bd WH Treg NA28 ] \u1f10\u03c3\u03c4\u03b9\u03bd \u1f21 \u1f10\u03bd\u03c4\u03bf\u03bb\u03ae RP , \u03ba\u03b1\u03b8\u1f7c\u03c2 \u1f20\u03ba\u03bf\u03cd\u03c3\u03b1\u03c4\u03b5 \u1f00\u03c0\u02bc \u1f00\u03c1\u03c7\u1fc6\u03c2, \u1f35\u03bd\u03b1 \u1f10\u03bd \u03b1\u1f50\u03c4\u1fc7 \u03c0\u03b5\u03c1\u03b9\u03c0\u03b1\u03c4\u1fc6\u03c4\u03b5.",
      "7": "\u1f45\u03c4\u03b9 \u03c0\u03bf\u03bb\u03bb\u03bf\u1f76 \u03c0\u03bb\u03ac\u03bd\u03bf\u03b9 \u2e00\u1f10\u03be\u1fc6\u03bb\u03b8\u03bf\u03bd \u00a7 \u1f10\u03be\u1fc6\u03bb\u03b8\u03bf\u03bd WH Treg NA28 ] \u03b5\u1f30\u03c3\u1fc6\u03bb\u03b8\u03cc\u03bd RP \u03b5\u1f30\u03c2 \u03c4\u1f78\u03bd \u03ba\u03cc\u03c3\u03bc\u03bf\u03bd, \u03bf\u1f31 \u03bc\u1f74 \u1f41\u03bc\u03bf\u03bb\u03bf\u03b3\u03bf\u1fe6\u03bd\u03c4\u03b5\u03c2 \u1f38\u03b7\u03c3\u03bf\u1fe6\u03bd \u03a7\u03c1\u03b9\u03c3\u03c4\u1f78\u03bd \u1f10\u03c1\u03c7\u03cc\u03bc\u03b5\u03bd\u03bf\u03bd \u1f10\u03bd \u03c3\u03b1\u03c1\u03ba\u03af\u00b7 \u03bf\u1f57\u03c4\u03cc\u03c2 \u1f10\u03c3\u03c4\u03b9\u03bd \u1f41 \u03c0\u03bb\u03ac\u03bd\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f41 \u1f00\u03bd\u03c4\u03af\u03c7\u03c1\u03b9\u03c3\u03c4\u03bf\u03c2.",
      "8": "\u03b2\u03bb\u03ad\u03c0\u03b5\u03c4\u03b5 \u1f11\u03b1\u03c5\u03c4\u03bf\u03cd\u03c2, \u1f35\u03bd\u03b1 \u03bc\u1f74 \u2e00\u1f00\u03c0\u03bf\u03bb\u03ad\u03c3\u03b7\u03c4\u03b5 * \u1f00\u03c0\u03bf\u03bb\u03ad\u03c3\u03b7\u03c4\u03b5 WH Treg NA28 ] \u1f00\u03c0\u03bf\u03bb\u03ad\u03c3\u03c9\u03bc\u03b5\u03bd RP \u1f03 \u2e00\u03b5\u1f30\u03c1\u03b3\u03b1\u03c3\u03ac\u03bc\u03b5\u03b8\u03b1 \u2020 \u03b5\u1f30\u03c1\u03b3\u03b1\u03c3\u03ac\u03bc\u03b5\u03b8\u03b1 WH RP NA28 ] \u03b5\u1f30\u03c1\u03b3\u03ac\u03c3\u03b1\u03c3\u03b8\u03b5 Treg NIV \u1f00\u03bb\u03bb\u1f70 \u03bc\u03b9\u03c3\u03b8\u1f78\u03bd \u03c0\u03bb\u03ae\u03c1\u03b7 \u2e00\u1f00\u03c0\u03bf\u03bb\u03ac\u03b2\u03b7\u03c4\u03b5 \u2021 \u1f00\u03c0\u03bf\u03bb\u03ac\u03b2\u03b7\u03c4\u03b5 WH Treg NA28 ] \u1f00\u03c0\u03bf\u03bb\u03ac\u03b2\u03c9\u03bc\u03b5\u03bd RP",
      "9": "\u03c0\u1fb6\u03c2 \u1f41 \u2e00\u03c0\u03c1\u03bf\u03ac\u03b3\u03c9\u03bd \u00a7 \u03c0\u03c1\u03bf\u03ac\u03b3\u03c9\u03bd WH Treg NA28 ] \u03c0\u03b1\u03c1\u03b1\u03b2\u03b1\u03af\u03bd\u03c9\u03bd RP \u03ba\u03b1\u1f76 \u03bc\u1f74 \u03bc\u03ad\u03bd\u03c9\u03bd \u1f10\u03bd \u03c4\u1fc7 \u03b4\u03b9\u03b4\u03b1\u03c7\u1fc7 * \u03b4\u03b9\u03b4\u03b1\u03c7\u1fc7 WH Treg NA28 ] + \u03c4\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6 RP \u03c4\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6 \u03b8\u03b5\u1f78\u03bd \u03bf\u1f50\u03ba \u1f14\u03c7\u03b5\u03b9\u00b7 \u1f41 \u03bc\u03ad\u03bd\u03c9\u03bd \u1f10\u03bd \u03c4\u1fc7 \u2e00\u03b4\u03b9\u03b4\u03b1\u03c7\u1fc7, \u03bf\u1f57\u03c4\u03bf\u03c2 \u03ba\u03b1\u1f76 \u03c4\u1f78\u03bd \u03c0\u03b1\u03c4\u03ad\u03c1\u03b1 \u03ba\u03b1\u1f76 \u03c4\u1f78\u03bd \u03c5\u1f31\u1f78\u03bd \u1f14\u03c7\u03b5\u03b9.",
      "10": "\u03b5\u1f34 \u03c4\u03b9\u03c2 \u1f14\u03c1\u03c7\u03b5\u03c4\u03b1\u03b9 \u03c0\u03c1\u1f78\u03c2 \u1f51\u03bc\u1fb6\u03c2 \u03ba\u03b1\u1f76 \u03c4\u03b1\u03cd\u03c4\u03b7\u03bd \u03c4\u1f74\u03bd \u03b4\u03b9\u03b4\u03b1\u03c7\u1f74\u03bd \u03bf\u1f50 \u03c6\u03ad\u03c1\u03b5\u03b9, \u03bc\u1f74 \u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03b5\u03c4\u03b5 \u03b1\u1f50\u03c4\u1f78\u03bd \u03b5\u1f30\u03c2 \u03bf\u1f30\u03ba\u03af\u03b1\u03bd \u03ba\u03b1\u1f76 \u03c7\u03b1\u03af\u03c1\u03b5\u03b9\u03bd \u03b1\u1f50\u03c4\u1ff7 \u03bc\u1f74 \u03bb\u03ad\u03b3\u03b5\u03c4\u03b5\u00b7",
      "11": "\u1f41 \u2e02\u03bb\u03ad\u03b3\u03c9\u03bd \u03b3\u1f70\u03c1 \u2020 \u03bb\u03ad\u03b3\u03c9\u03bd \u03b3\u1f70\u03c1 WH Treg NA28 ] \u03b3\u1f70\u03c1 \u03bb\u03ad\u03b3\u03c9\u03bd RP \u03b1\u1f50\u03c4\u1ff7 \u03c7\u03b1\u03af\u03c1\u03b5\u03b9\u03bd \u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03b5\u1fd6 \u03c4\u03bf\u1fd6\u03c2 \u1f14\u03c1\u03b3\u03bf\u03b9\u03c2 \u03b1\u1f50\u03c4\u03bf\u1fe6 \u03c4\u03bf\u1fd6\u03c2 \u03c0\u03bf\u03bd\u03b7\u03c1\u03bf\u1fd6\u03c2.",
      "12": "\u03a0\u03bf\u03bb\u03bb\u1f70 \u1f14\u03c7\u03c9\u03bd \u1f51\u03bc\u1fd6\u03bd \u03b3\u03c1\u03ac\u03c6\u03b5\u03b9\u03bd \u03bf\u1f50\u03ba \u1f10\u03b2\u03bf\u03c5\u03bb\u03ae\u03b8\u03b7\u03bd \u03b4\u03b9\u1f70 \u03c7\u03ac\u03c1\u03c4\u03bf\u03c5 \u03ba\u03b1\u1f76 \u03bc\u03ad\u03bb\u03b1\u03bd\u03bf\u03c2, \u1f00\u03bb\u03bb\u1f70 \u1f10\u03bb\u03c0\u03af\u03b6\u03c9 \u2e00\u03b3\u03b5\u03bd\u03ad\u03c3\u03b8\u03b1\u03b9 \u2021 \u03b3\u03b5\u03bd\u03ad\u03c3\u03b8\u03b1\u03b9 WH Treg NA28 ] \u1f10\u03bb\u03b8\u03b5\u1fd6\u03bd RP \u03c0\u03c1\u1f78\u03c2 \u1f51\u03bc\u1fb6\u03c2 \u03ba\u03b1\u1f76 \u03c3\u03c4\u03cc\u03bc\u03b1 \u03c0\u03c1\u1f78\u03c2 \u03c3\u03c4\u03cc\u03bc\u03b1 \u03bb\u03b1\u03bb\u1fc6\u03c3\u03b1\u03b9, \u1f35\u03bd\u03b1 \u1f21 \u03c7\u03b1\u03c1\u1f70 \u2e00\u1f51\u03bc\u1ff6\u03bd \u00a7 \u1f51\u03bc\u1ff6\u03bd WH Treg ] \u1f21\u03bc\u1ff6\u03bd NA28 RP \u2e02\u03c0\u03b5\u03c0\u03bb\u03b7\u03c1\u03c9\u03bc\u03ad\u03bd\u03b7 \u1f96 * \u03c0\u03b5\u03c0\u03bb\u03b7\u03c1\u03c9\u03bc\u03ad\u03bd\u03b7 \u1f96 WH NA27 ] \u1f96 \u03c0\u03b5\u03c0\u03bb\u03b7\u03c1\u03c9\u03bc\u03ad\u03bd\u03b7 Treg NA28 RP .",
      "13": "\u1f08\u03c3\u03c0\u03ac\u03b6\u03b5\u03c4\u03b1\u03af \u03c3\u03b5 \u03c4\u1f70 \u03c4\u03ad\u03ba\u03bd\u03b1 \u03c4\u1fc6\u03c2 \u1f00\u03b4\u03b5\u03bb\u03c6\u1fc6\u03c2 \u03c3\u03bf\u03c5 \u03c4\u1fc6\u03c2 \u2e00\u1f10\u03ba\u03bb\u03b5\u03ba\u03c4\u1fc6\u03c2 \u2020 \u1f10\u03ba\u03bb\u03b5\u03ba\u03c4\u1fc6\u03c2 WH Treg NA28 ] + \u1f08\u03bc\u03ae\u03bd RP \u2018p /\u2019 \u2018/book\u2019"
    }
  }
}