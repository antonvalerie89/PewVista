  "cache_version": 6,
  "book_number": 61,
  "source_kind": "ebible_html_zip",
  "source_name": "Text-Critical Greek NT",
  "chapters": {
    "1": {
      "1": "* \u03c3\u03c5\u03bc\u03b5\u03c9\u03bd \u00a6 \u03c3\u03b9\u03bc\u03c9\u03bd \ua731\u1d04\u0280 \u1d21\u029c \u03a3\u03c5\u03bc\u03b5\u1f7c\u03bd \u03a0\u03ad\u03c4\u03c1\u03bf\u03c2, \u03b4\u03bf\u1fe6\u03bb\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f00\u03c0\u03cc\u03c3\u03c4\u03bf\u03bb\u03bf\u03c2 \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6, \u03c4\u03bf\u1fd6\u03c2 \u1f30\u03c3\u03cc\u03c4\u03b9\u03bc\u03bf\u03bd \u1f21\u03bc\u1fd6\u03bd \u03bb\u03b1\u03c7\u03bf\u1fe6\u03c3\u03b9 \u03c0\u03af\u03c3\u03c4\u03b9\u03bd \u1f10\u03bd \u03b4\u03b9\u03ba\u03b1\u03b9\u03bf\u03c3\u03cd\u03bd\u1fc3 \u03c4\u03bf\u1fe6 \u0398\u03b5\u03bf\u1fe6 \u1f21\u03bc\u1ff6\u03bd \u03ba\u03b1\u1f76 \u2020 \u03c3\u03c9\u03c4\u03b7\u03c1\u03bf\u03c2 \u00a6 \u03c3\u03c9\u03c4\u03b7\u03c1\u03bf\u03c2 \u03b7\u03bc\u03c9\u03bd \ua731\u1d04\u0280 \u03c3\u03c9\u03c4\u1fc6\u03c1\u03bf\u03c2 \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6\u00b7",
      "2": "\u03c7\u03ac\u03c1\u03b9\u03c2 \u1f51\u03bc\u1fd6\u03bd \u03ba\u03b1\u1f76 \u03b5\u1f30\u03c1\u03ae\u03bd\u03b7 \u03c0\u03bb\u03b7\u03b8\u03c5\u03bd\u03b8\u03b5\u03af\u03b7 \u1f10\u03bd \u1f10\u03c0\u03b9\u03b3\u03bd\u03ce\u03c3\u03b5\u03b9 \u03c4\u03bf\u1fe6 \u0398\u03b5\u03bf\u1fe6 \u03ba\u03b1\u1f76 \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03c4\u03bf\u1fe6 \u039a\u03c5\u03c1\u03af\u03bf\u03c5 \u1f21\u03bc\u1ff6\u03bd.",
      "3": "\u1f69\u03c2 \u03c0\u03ac\u03bd\u03c4\u03b1 \u1f21\u03bc\u1fd6\u03bd \u03c4\u1fc6\u03c2 \u03b8\u03b5\u03af\u03b1\u03c2 \u03b4\u03c5\u03bd\u03ac\u03bc\u03b5\u03c9\u03c2 \u03b1\u1f50\u03c4\u03bf\u1fe6 \u03c4\u1f70 \u03c0\u03c1\u1f78\u03c2 \u03b6\u03c9\u1f74\u03bd \u03ba\u03b1\u1f76 \u03b5\u1f50\u03c3\u03ad\u03b2\u03b5\u03b9\u03b1\u03bd \u03b4\u03b5\u03b4\u03c9\u03c1\u03b7\u03bc\u03ad\u03bd\u03b7\u03c2 \u03b4\u03b9\u1f70 \u03c4\u1fc6\u03c2 \u1f10\u03c0\u03b9\u03b3\u03bd\u03ce\u03c3\u03b5\u03c9\u03c2 \u03c4\u03bf\u1fe6 \u03ba\u03b1\u03bb\u03ad\u03c3\u03b1\u03bd\u03c4\u03bf\u03c2 \u1f21\u03bc\u1fb6\u03c2 \u2021 \u03b4\u03b9\u03b1 \u03b4\u03bf\u03be\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03b1\u03c1\u03b5\u03c4\u03b7\u03c2 \u00a6 \u03b9\u03b4\u03b9\u03b1 \u03b4\u03bf\u03be\u03b7 \u03ba\u03b1\u03b9 \u03b1\u03c1\u03b5\u03c4\u03b7 \u0274\u1d00 \ua731\u0299\u029f \u1d1b\u029c \u03b4\u03b9\u1f70 \u03b4\u03cc\u03be\u03b7\u03c2 \u03ba\u03b1\u1f76 \u1f00\u03c1\u03b5\u03c4\u1fc6\u03c2,",
      "4": "\u03b4\u03b9\u1fbd \u1f67\u03bd \u03c4\u1f70 \u00a7 \u03c4\u03b9\u03bc\u03b9\u03b1 \u03b7\u03bc\u03b9\u03bd \u03ba\u03b1\u03b9 \u03bc\u03b5\u03b3\u03b9\u03c3\u03c4\u03b1 75.8% \u00a6 \u03bc\u03b5\u03b3\u03b9\u03c3\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03b9\u03bc\u03b9\u03b1 \u03b7\u03bc\u03b9\u03bd \u1d0d\ua731\ua731 6.8% \u00a6 \u03c4\u03b9\u03bc\u03b9\u03b1 \u03ba\u03b1\u03b9 \u03bc\u03b5\u03b3\u03b9\u03c3\u03c4\u03b1 \u03b7\u03bc\u03b9\u03bd \u0274\u1d00 \ua731\u0299\u029f \u1d21\u029c 5.9% \u00a6 \u03bc\u03b5\u03b3\u03b9\u03c3\u03c4\u03b1 \u03b7\u03bc\u03b9\u03bd \u03ba\u03b1\u03b9 \u03c4\u03b9\u03bc\u03b9\u03b1 \u1d1b\u0280 1% \u03c4\u03af\u03bc\u03b9\u03b1 \u1f21\u03bc\u1fd6\u03bd \u03ba\u03b1\u1f76 \u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03b1 \u1f10\u03c0\u03b1\u03b3\u03b3\u03ad\u03bb\u03bc\u03b1\u03c4\u03b1 \u03b4\u03b5\u03b4\u03ce\u03c1\u03b7\u03c4\u03b1\u03b9, \u1f35\u03bd\u03b1 \u03b4\u03b9\u1f70 \u03c4\u03bf\u03cd\u03c4\u03c9\u03bd \u03b3\u03ad\u03bd\u03b7\u03c3\u03b8\u03b5 \u03b8\u03b5\u03af\u03b1\u03c2 \u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03bf\u1f76 \u03c6\u03cd\u03c3\u03b5\u03c9\u03c2 \u1f00\u03c0\u03bf\u03c6\u03c5\u03b3\u03cc\u03bd\u03c4\u03b5\u03c2 \u03c4\u1fc6\u03c2 \u1f10\u03bd * \u03ba\u03bf\u03c3\u03bc\u03c9 \u00a6 \u03c4\u03c9 \u03ba\u03bf\u03c3\u03bc\u03c9 \u1d04\u1d1b \u03ba\u03cc\u03c3\u03bc\u1ff3 \u1f10\u03bd \u1f10\u03c0\u03b9\u03b8\u03c5\u03bc\u03af\u1fb3 \u03c6\u03b8\u03bf\u03c1\u1fb6\u03c2.",
      "5": "\u03ba\u03b1\u1f76 \u03b1\u1f50\u03c4\u1f78 \u2020 \u03c4\u03bf\u03c5\u03c4\u03bf \u03b4\u03b5 \u00a6 \u03b4\u03b5 \u03c4\u03bf\u03c5\u03c4\u03bf \u1d18\u1d04\u1d0b \u03c4\u03bf\u1fe6\u03c4\u03bf \u03b4\u1f72 \u03c3\u03c0\u03bf\u03c5\u03b4\u1f74\u03bd \u03c0\u1fb6\u03c3\u03b1\u03bd \u03c0\u03b1\u03c1\u03b5\u03b9\u03c3\u03b5\u03bd\u03ad\u03b3\u03ba\u03b1\u03bd\u03c4\u03b5\u03c2 \u1f10\u03c0\u03b9\u03c7\u03bf\u03c1\u03b7\u03b3\u03ae\u03c3\u03b1\u03c4\u03b5 \u1f10\u03bd \u03c4\u1fc7 \u03c0\u03af\u03c3\u03c4\u03b5\u03b9 \u1f51\u03bc\u1ff6\u03bd \u03c4\u1f74\u03bd \u1f00\u03c1\u03b5\u03c4\u03ae\u03bd, \u1f10\u03bd \u03b4\u1f72 \u03c4\u1fc7 \u1f00\u03c1\u03b5\u03c4\u1fc7 \u03c4\u1f74\u03bd \u03b3\u03bd\u1ff6\u03c3\u03b9\u03bd,",
      "6": "\u1f10\u03bd \u03b4\u1f72 \u03c4\u1fc7 \u03b3\u03bd\u03ce\u03c3\u03b5\u03b9 \u03c4\u1f74\u03bd \u1f10\u03b3\u03ba\u03c1\u03ac\u03c4\u03b5\u03b9\u03b1\u03bd, \u1f10\u03bd \u03b4\u1f72 \u03c4\u1fc7 \u1f10\u03b3\u03ba\u03c1\u03b1\u03c4\u03b5\u03af\u1fb3 \u03c4\u1f74\u03bd \u1f51\u03c0\u03bf\u03bc\u03bf\u03bd\u03ae\u03bd, \u1f10\u03bd \u03b4\u1f72 \u03c4\u1fc7 \u1f51\u03c0\u03bf\u03bc\u03bf\u03bd\u1fc7 \u03c4\u1f74\u03bd \u03b5\u1f50\u03c3\u03ad\u03b2\u03b5\u03b9\u03b1\u03bd,",
      "7": "\u1f10\u03bd \u03b4\u1f72 \u03c4\u1fc7 \u03b5\u1f50\u03c3\u03b5\u03b2\u03b5\u03af\u1fb3 \u03c4\u1f74\u03bd \u03c6\u03b9\u03bb\u03b1\u03b4\u03b5\u03bb\u03c6\u03af\u03b1\u03bd, \u1f10\u03bd \u03b4\u1f72 \u03c4\u1fc7 \u03c6\u03b9\u03bb\u03b1\u03b4\u03b5\u03bb\u03c6\u03af\u1fb3 \u03c4\u1f74\u03bd \u1f00\u03b3\u03ac\u03c0\u03b7\u03bd.",
      "8": "\u03c4\u03b1\u1fe6\u03c4\u03b1 \u03b3\u1f70\u03c1 \u1f51\u03bc\u1fd6\u03bd \u1f51\u03c0\u03ac\u03c1\u03c7\u03bf\u03bd\u03c4\u03b1 \u03ba\u03b1\u1f76 \u03c0\u03bb\u03b5\u03bf\u03bd\u03ac\u03b6\u03bf\u03bd\u03c4\u03b1 \u03bf\u1f50\u03ba \u1f00\u03c1\u03b3\u03bf\u1f7a\u03c2 \u03bf\u1f50\u03b4\u1f72 \u1f00\u03ba\u03ac\u03c1\u03c0\u03bf\u03c5\u03c2 \u03ba\u03b1\u03b8\u03af\u03c3\u03c4\u03b7\u03c3\u03b9\u03bd \u03b5\u1f30\u03c2 \u03c4\u1f74\u03bd \u03c4\u03bf\u1fe6 \u039a\u03c5\u03c1\u03af\u03bf\u03c5 \u1f21\u03bc\u1ff6\u03bd \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6 \u1f10\u03c0\u03af\u03b3\u03bd\u03c9\u03c3\u03b9\u03bd\u00b7",
      "9": "\u1fa7 \u03b3\u1f70\u03c1 \u03bc\u1f74 \u03c0\u03ac\u03c1\u03b5\u03c3\u03c4\u03b9 \u03c4\u03b1\u1fe6\u03c4\u03b1, \u03c4\u03c5\u03c6\u03bb\u03cc\u03c2 \u1f10\u03c3\u03c4\u03b9 \u03bc\u03c5\u03c9\u03c0\u03ac\u03b6\u03c9\u03bd, \u03bb\u03ae\u03b8\u03b7\u03bd \u03bb\u03b1\u03b2\u1f7c\u03bd \u03c4\u03bf\u1fe6 \u03ba\u03b1\u03b8\u03b1\u03c1\u03b9\u03c3\u03bc\u03bf\u1fe6 \u03c4\u1ff6\u03bd \u03c0\u03ac\u03bb\u03b1\u03b9 \u03b1\u1f50\u03c4\u03bf\u1fe6 \u2021 \u03b1\u03bc\u03b1\u03c1\u03c4\u03b9\u03c9\u03bd \u00a6 \u03b1\u03bc\u03b1\u03c1\u03c4\u03b7\u03bc\u03b1\u03c4\u03c9\u03bd \ua731\u0299\u029f \u1f01\u03bc\u03b1\u03c1\u03c4\u03b9\u1ff6\u03bd.",
      "10": "\u03b4\u03b9\u1f78 \u03bc\u1fb6\u03bb\u03bb\u03bf\u03bd, \u1f00\u03b4\u03b5\u03bb\u03c6\u03bf\u03af, \u03c3\u03c0\u03bf\u03c5\u03b4\u03ac\u03c3\u03b1\u03c4\u03b5 \u03b2\u03b5\u03b2\u03b1\u03af\u03b1\u03bd \u1f51\u03bc\u1ff6\u03bd \u03c4\u1f74\u03bd \u03ba\u03bb\u1fc6\u03c3\u03b9\u03bd \u03ba\u03b1\u1f76 \u1f10\u03ba\u03bb\u03bf\u03b3\u1f74\u03bd \u03c0\u03bf\u03b9\u03b5\u1fd6\u03c3\u03b8\u03b1\u03b9\u00b7 \u03c4\u03b1\u1fe6\u03c4\u03b1 \u03b3\u1f70\u03c1 \u03c0\u03bf\u03b9\u03bf\u1fe6\u03bd\u03c4\u03b5\u03c2 \u03bf\u1f50 \u03bc\u1f74 \u03c0\u03c4\u03b1\u03af\u03c3\u03b7\u03c4\u03ad \u03c0\u03bf\u03c4\u03b5.",
      "11": "\u03bf\u1f55\u03c4\u03c9 \u03b3\u1f70\u03c1 \u03c0\u03bb\u03bf\u03c5\u03c3\u03af\u03c9\u03c2 \u1f10\u03c0\u03b9\u03c7\u03bf\u03c1\u03b7\u03b3\u03b7\u03b8\u03ae\u03c3\u03b5\u03c4\u03b1\u03b9 \u1f51\u03bc\u1fd6\u03bd \u1f21 \u03b5\u1f34\u03c3\u03bf\u03b4\u03bf\u03c2 \u03b5\u1f30\u03c2 \u03c4\u1f74\u03bd \u03b1\u1f30\u03ce\u03bd\u03b9\u03bf\u03bd \u03b2\u03b1\u03c3\u03b9\u03bb\u03b5\u03af\u03b1\u03bd \u03c4\u03bf\u1fe6 \u039a\u03c5\u03c1\u03af\u03bf\u03c5 \u1f21\u03bc\u1ff6\u03bd \u03ba\u03b1\u1f76 \u03c3\u03c9\u03c4\u1fc6\u03c1\u03bf\u03c2 \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6.",
      "12": "\u0394\u03b9\u1f78 \u00a7 \u03bf\u03c5\u03ba \u03b1\u03bc\u03b5\u03bb\u03b7\u03c3\u03c9 95.2% \u00a6 \u03bc\u03b5\u03bb\u03bb\u03b7\u03c3\u03c9 \u1d04\u1d1b 2.8% \u03bf\u1f50\u03ba \u1f00\u03bc\u03b5\u03bb\u03ae\u03c3\u03c9 * \u03b1\u03b5\u03b9 \u03c5\u03bc\u03b1\u03c2 \u00a6 \u03c5\u03bc\u03b1\u03c2 \u03b1\u03b5\u03b9 \u1d1b\u0280 \u1f00\u03b5\u1f76 \u1f51\u03bc\u1fb6\u03c2 \u1f51\u03c0\u03bf\u03bc\u03b9\u03bc\u03bd\u1fc4\u03c3\u03ba\u03b5\u03b9\u03bd \u03c0\u03b5\u03c1\u1f76 \u03c4\u03bf\u03cd\u03c4\u03c9\u03bd, \u03ba\u03b1\u03af\u03c0\u03b5\u03c1 \u03b5\u1f30\u03b4\u03cc\u03c4\u03b1\u03c2 \u03ba\u03b1\u1f76 \u1f10\u03c3\u03c4\u03b7\u03c1\u03b9\u03b3\u03bc\u03ad\u03bd\u03bf\u03c5\u03c2 \u1f10\u03bd \u03c4\u1fc7 \u03c0\u03b1\u03c1\u03bf\u03cd\u03c3\u1fc3 \u1f00\u03bb\u03b7\u03b8\u03b5\u03af\u1fb3.",
      "13": "\u03b4\u03af\u03ba\u03b1\u03b9\u03bf\u03bd \u03b4\u1f72 \u1f21\u03b3\u03bf\u1fe6\u03bc\u03b1\u03b9, \u1f10\u03c6\u1fbd \u1f45\u03c3\u03bf\u03bd \u03b5\u1f30\u03bc\u1f76 \u1f10\u03bd \u03c4\u03bf\u03cd\u03c4\u1ff3 \u03c4\u1ff7 \u03c3\u03ba\u03b7\u03bd\u03ce\u03bc\u03b1\u03c4\u03b9, \u03b4\u03b9\u03b5\u03b3\u03b5\u03af\u03c1\u03b5\u03b9\u03bd \u1f51\u03bc\u1fb6\u03c2 \u1f10\u03bd \u1f51\u03c0\u03bf\u03bc\u03bd\u03ae\u03c3\u03b5\u03b9,",
      "14": "\u03b5\u1f30\u03b4\u1f7c\u03c2 \u1f45\u03c4\u03b9 \u03c4\u03b1\u03c7\u03b9\u03bd\u03ae \u1f10\u03c3\u03c4\u03b9\u03bd \u1f21 \u1f00\u03c0\u03cc\u03b8\u03b5\u03c3\u03b9\u03c2 \u03c4\u03bf\u1fe6 \u03c3\u03ba\u03b7\u03bd\u03ce\u03bc\u03b1\u03c4\u03cc\u03c2 \u03bc\u03bf\u03c5, \u03ba\u03b1\u03b8\u1f7c\u03c2 \u03ba\u03b1\u1f76 \u1f41 \u039a\u03cd\u03c1\u03b9\u03bf\u03c2 \u1f21\u03bc\u1ff6\u03bd \u1f38\u03b7\u03c3\u03bf\u1fe6\u03c2 \u03a7\u03c1\u03b9\u03c3\u03c4\u1f78\u03c2 \u1f10\u03b4\u03ae\u03bb\u03c9\u03c3\u03ad \u03bc\u03bf\u03b9.",
      "15": "\u03c3\u03c0\u03bf\u03c5\u03b4\u03ac\u03c3\u03c9 \u03b4\u1f72 \u03ba\u03b1\u1f76 \u1f11\u03ba\u03ac\u03c3\u03c4\u03bf\u03c4\u03b5 \u1f14\u03c7\u03b5\u03b9\u03bd \u1f51\u03bc\u1fb6\u03c2 \u03bc\u03b5\u03c4\u1f70 \u03c4\u1f74\u03bd \u1f10\u03bc\u1f74\u03bd \u1f14\u03be\u03bf\u03b4\u03bf\u03bd \u03c4\u1f74\u03bd \u03c4\u03bf\u03cd\u03c4\u03c9\u03bd \u03bc\u03bd\u03ae\u03bc\u03b7\u03bd \u03c0\u03bf\u03b9\u03b5\u1fd6\u03c3\u03b8\u03b1\u03b9.",
      "16": "\u039f\u1f50 \u03b3\u1f70\u03c1 \u03c3\u03b5\u03c3\u03bf\u03c6\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf\u03b9\u03c2 \u03bc\u03cd\u03b8\u03bf\u03b9\u03c2 \u1f10\u03be\u03b1\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03ae\u03c3\u03b1\u03bd\u03c4\u03b5\u03c2 \u1f10\u03b3\u03bd\u03c9\u03c1\u03af\u03c3\u03b1\u03bc\u03b5\u03bd \u1f51\u03bc\u1fd6\u03bd \u03c4\u1f74\u03bd \u03c4\u03bf\u1fe6 \u039a\u03c5\u03c1\u03af\u03bf\u03c5 \u1f21\u03bc\u1ff6\u03bd \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6 \u03b4\u03cd\u03bd\u03b1\u03bc\u03b9\u03bd \u03ba\u03b1\u1f76 \u03c0\u03b1\u03c1\u03bf\u03c5\u03c3\u03af\u03b1\u03bd, \u1f00\u03bb\u03bb\u1fbd \u1f10\u03c0\u03cc\u03c0\u03c4\u03b1\u03b9 \u03b3\u03b5\u03bd\u03b7\u03b8\u03ad\u03bd\u03c4\u03b5\u03c2 \u03c4\u1fc6\u03c2 \u1f10\u03ba\u03b5\u03af\u03bd\u03bf\u03c5 \u03bc\u03b5\u03b3\u03b1\u03bb\u03b5\u03b9\u03cc\u03c4\u03b7\u03c4\u03bf\u03c2.",
      "17": "\u03bb\u03b1\u03b2\u1f7c\u03bd \u03b3\u1f70\u03c1 \u03c0\u03b1\u03c1\u1f70 \u0398\u03b5\u03bf\u1fe6 \u03c0\u03b1\u03c4\u03c1\u1f78\u03c2 \u03c4\u03b9\u03bc\u1f74\u03bd \u03ba\u03b1\u1f76 \u03b4\u03cc\u03be\u03b1\u03bd \u03c6\u03c9\u03bd\u1fc6\u03c2 \u1f10\u03bd\u03b5\u03c7\u03b8\u03b5\u03af\u03c3\u03b7\u03c2 \u03b1\u1f50\u03c4\u1ff7 \u03c4\u03bf\u03b9\u1fb6\u03c3\u03b4\u03b5 \u1f51\u03c0\u1f78 \u03c4\u1fc6\u03c2 \u03bc\u03b5\u03b3\u03b1\u03bb\u03bf\u03c0\u03c1\u03b5\u03c0\u03bf\u1fe6\u03c2 \u03b4\u03cc\u03be\u03b7\u03c2, \u2020 \u03bf\u03c5\u03c4\u03bf\u03c2 \u03b5\u03c3\u03c4\u03b9\u03bd \u03bf \u03c5\u03b9\u03bf\u03c2 \u03bc\u03bf\u03c5 \u03bf \u03b1\u03b3\u03b1\u03c0\u03b7\u03c4\u03bf\u03c2 97.6% \u00a6 \u03bf \u03c5\u03b9\u03bf\u03c2 \u03bc\u03bf\u03c5 \u03bf \u03b1\u03b3\u03b1\u03c0\u03b7\u03c4\u03bf\u03c2 \u03bc\u03bf\u03c5 \u03bf\u03c5\u03c4\u03bf\u03c2 \u03b5\u03c3\u03c4\u03b9\u03bd \u0274\u1d00 \ua731\u0299\u029f \u1d21\u029c 0.4% \u039f\u1f57\u03c4\u03cc\u03c2 \u1f10\u03c3\u03c4\u03b9\u03bd \u1f41 \u03c5\u1f31\u03cc\u03c2 \u03bc\u03bf\u03c5 \u1f41 \u1f00\u03b3\u03b1\u03c0\u03b7\u03c4\u03cc\u03c2, \u03b5\u1f30\u03c2 \u1f43\u03bd \u1f10\u03b3\u1f7c \u03b5\u1f50\u03b4\u03cc\u03ba\u03b7\u03c3\u03b1,",
      "18": "\u03ba\u03b1\u1f76 \u03c4\u03b1\u03cd\u03c4\u03b7\u03bd \u03c4\u1f74\u03bd \u03c6\u03c9\u03bd\u1f74\u03bd \u1f21\u03bc\u03b5\u1fd6\u03c2 \u1f20\u03ba\u03bf\u03cd\u03c3\u03b1\u03bc\u03b5\u03bd \u1f10\u03be \u03bf\u1f50\u03c1\u03b1\u03bd\u03bf\u1fe6 \u1f10\u03bd\u03b5\u03c7\u03b8\u03b5\u1fd6\u03c3\u03b1\u03bd \u03c3\u1f7a\u03bd \u03b1\u1f50\u03c4\u1ff7 \u1f44\u03bd\u03c4\u03b5\u03c2 \u1f10\u03bd \u03c4\u1ff7 \u2021 \u03bf\u03c1\u03b5\u03b9 \u03c4\u03c9 \u03b1\u03b3\u03b9\u03c9 97.4% \u00a6 \u03b1\u03b3\u03b9\u03c9 \u03bf\u03c1\u03b5\u03b9 \u0274\u1d00 \ua731\u0299\u029f \u1d21\u029c 2.4% \u1f44\u03c1\u03b5\u03b9 \u03c4\u1ff7 \u1f01\u03b3\u03af\u1ff3.",
      "19": "\u03ba\u03b1\u1f76 \u1f14\u03c7\u03bf\u03bc\u03b5\u03bd \u03b2\u03b5\u03b2\u03b1\u03b9\u03cc\u03c4\u03b5\u03c1\u03bf\u03bd \u03c4\u1f78\u03bd \u03c0\u03c1\u03bf\u03c6\u03b7\u03c4\u03b9\u03ba\u1f78\u03bd \u03bb\u03cc\u03b3\u03bf\u03bd, \u1fa7 \u03ba\u03b1\u03bb\u1ff6\u03c2 \u03c0\u03bf\u03b9\u03b5\u1fd6\u03c4\u03b5 \u03c0\u03c1\u03bf\u03c3\u03ad\u03c7\u03bf\u03bd\u03c4\u03b5\u03c2 \u1f61\u03c2 \u03bb\u03cd\u03c7\u03bd\u1ff3 \u03c6\u03b1\u03af\u03bd\u03bf\u03bd\u03c4\u03b9 \u1f10\u03bd \u03b1\u1f50\u03c7\u03bc\u03b7\u03c1\u1ff7 \u03c4\u03cc\u03c0\u1ff3, \u1f15\u03c9\u03c2 \u03bf\u1f57 \u1f21\u03bc\u03ad\u03c1\u03b1 \u03b4\u03b9\u03b1\u03c5\u03b3\u03ac\u03c3\u1fc3 \u03ba\u03b1\u1f76 \u03c6\u03c9\u03c3\u03c6\u03cc\u03c1\u03bf\u03c2 \u1f00\u03bd\u03b1\u03c4\u03b5\u03af\u03bb\u1fc3 \u1f10\u03bd \u03c4\u03b1\u1fd6\u03c2 \u03ba\u03b1\u03c1\u03b4\u03af\u03b1\u03b9\u03c2 \u1f51\u03bc\u1ff6\u03bd\u00b7",
      "20": "\u03c4\u03bf\u1fe6\u03c4\u03bf \u03c0\u03c1\u1ff6\u03c4\u03bf\u03bd \u03b3\u03b9\u03bd\u03ce\u03c3\u03ba\u03bf\u03bd\u03c4\u03b5\u03c2, \u1f45\u03c4\u03b9 \u03c0\u1fb6\u03c3\u03b1 \u03c0\u03c1\u03bf\u03c6\u03b7\u03c4\u03b5\u03af\u03b1 \u03b3\u03c1\u03b1\u03c6\u1fc6\u03c2 \u1f30\u03b4\u03af\u03b1\u03c2 \u1f10\u03c0\u03b9\u03bb\u03cd\u03c3\u03b5\u03c9\u03c2 \u03bf\u1f50 \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9.",
      "21": "\u03bf\u1f50 \u03b3\u1f70\u03c1 \u03b8\u03b5\u03bb\u03ae\u03bc\u03b1\u03c4\u03b9 \u1f00\u03bd\u03b8\u03c1\u03ce\u03c0\u03bf\u03c5 \u1f20\u03bd\u03ad\u03c7\u03b8\u03b7 \u00a7 \u03c0\u03bf\u03c4\u03b5 \u03c0\u03c1\u03bf\u03c6\u03b7\u03c4\u03b5\u03b9\u03b1 \u00a6 \u03c0\u03c1\u03bf\u03c6\u03b7\u03c4\u03b5\u03b9\u03b1 \u03c0\u03bf\u03c4\u03b5 \u1d04\u1d1b \u03c0\u03bf\u03c4\u1f72 \u03c0\u03c1\u03bf\u03c6\u03b7\u03c4\u03b5\u03af\u03b1, * \u03b1\u03bb\u03bb \u00a6 \u03b1\u03bb\u03bb\u03b1 \ua731\u0299\u029f \u1d1b\u029c \u1d21\u029c \u1f00\u03bb\u03bb\u1fbd \u1f51\u03c0\u1f78 \u03a0\u03bd\u03b5\u03cd\u03bc\u03b1\u03c4\u03bf\u03c2 \u1f09\u03b3\u03af\u03bf\u03c5 \u03c6\u03b5\u03c1\u03cc\u03bc\u03b5\u03bd\u03bf\u03b9 \u1f10\u03bb\u03ac\u03bb\u03b7\u03c3\u03b1\u03bd \u2020 \u03b1\u03b3\u03b9\u03bf\u03b9 83.5% \u00a6 \u03b1\u03c0\u03bf \u1d04\u1d1b 5.6% \u00a6 \u03bf\u03b9 \u03b1\u03b3\u03b9\u03bf\u03b9 \ua731\u1d1b 4.4% \u1f05\u03b3\u03b9\u03bf\u03b9 \u0398\u03b5\u03bf\u1fe6 \u1f04\u03bd\u03b8\u03c1\u03c9\u03c0\u03bf\u03b9."
    },
    "2": {
      "1": "\u1f18\u03b3\u03ad\u03bd\u03bf\u03bd\u03c4\u03bf \u03b4\u1f72 \u03ba\u03b1\u1f76 \u03c8\u03b5\u03c5\u03b4\u03bf\u03c0\u03c1\u03bf\u03c6\u1fc6\u03c4\u03b1\u03b9 \u1f10\u03bd \u03c4\u1ff7 \u03bb\u03b1\u1ff7, \u1f61\u03c2 \u03ba\u03b1\u1f76 \u1f10\u03bd \u1f51\u03bc\u1fd6\u03bd \u1f14\u03c3\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c8\u03b5\u03c5\u03b4\u03bf\u03b4\u03b9\u03b4\u03ac\u03c3\u03ba\u03b1\u03bb\u03bf\u03b9, \u03bf\u1f35\u03c4\u03b9\u03bd\u03b5\u03c2 \u03c0\u03b1\u03c1\u03b5\u03b9\u03c3\u03ac\u03be\u03bf\u03c5\u03c3\u03b9\u03bd \u03b1\u1f31\u03c1\u03ad\u03c3\u03b5\u03b9\u03c2 \u1f00\u03c0\u03c9\u03bb\u03b5\u03af\u03b1\u03c2, \u03ba\u03b1\u1f76 \u03c4\u1f78\u03bd \u1f00\u03b3\u03bf\u03c1\u03ac\u03c3\u03b1\u03bd\u03c4\u03b1 \u03b1\u1f50\u03c4\u03bf\u1f7a\u03c2 \u0394\u03b5\u03c3\u03c0\u03cc\u03c4\u03b7\u03bd \u1f00\u03c1\u03bd\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf\u03b9, \u1f10\u03c0\u03ac\u03b3\u03bf\u03bd\u03c4\u03b5\u03c2 \u1f11\u03b1\u03c5\u03c4\u03bf\u1fd6\u03c2 \u03c4\u03b1\u03c7\u03b9\u03bd\u1f74\u03bd \u1f00\u03c0\u03ce\u03bb\u03b5\u03b9\u03b1\u03bd.",
      "2": "\u03ba\u03b1\u1f76 \u03c0\u03bf\u03bb\u03bb\u03bf\u1f76 \u1f10\u03be\u03b1\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03ae\u03c3\u03bf\u03c5\u03c3\u03b9\u03bd \u03b1\u1f50\u03c4\u1ff6\u03bd \u03c4\u03b1\u1fd6\u03c2 * \u03b1\u03c3\u03b5\u03bb\u03b3\u03b5\u03b9\u03b1\u03b9\u03c2 \u00a6 \u03b1\u03c0\u03c9\u03bb\u03b5\u03b9\u03b1\u03b9\u03c2 \u1d1b\u0280 \u1f00\u03c3\u03b5\u03bb\u03b3\u03b5\u03af\u03b1\u03b9\u03c2, \u03b4\u03b9\u1fbd \u2020 \u03bf\u03c5\u03c2 \u00a6 \u03b1\u03c2 \u1d18\u1d04\u1d0b \u03bf\u1f53\u03c2 \u1f21 \u1f41\u03b4\u1f78\u03c2 \u03c4\u1fc6\u03c2 \u1f00\u03bb\u03b7\u03b8\u03b5\u03af\u03b1\u03c2 \u03b2\u03bb\u03b1\u03c3\u03c6\u03b7\u03bc\u03b7\u03b8\u03ae\u03c3\u03b5\u03c4\u03b1\u03b9.",
      "3": "\u03ba\u03b1\u1f76 \u1f10\u03bd \u03c0\u03bb\u03b5\u03bf\u03bd\u03b5\u03be\u03af\u1fb3 \u03c0\u03bb\u03b1\u03c3\u03c4\u03bf\u1fd6\u03c2 \u03bb\u03cc\u03b3\u03bf\u03b9\u03c2 \u1f51\u03bc\u1fb6\u03c2 \u1f10\u03bc\u03c0\u03bf\u03c1\u03b5\u03cd\u03c3\u03bf\u03bd\u03c4\u03b1\u03b9\u00b7 \u03bf\u1f37\u03c2 \u03c4\u1f78 \u03ba\u03c1\u03af\u03bc\u03b1 \u1f14\u03ba\u03c0\u03b1\u03bb\u03b1\u03b9 \u03bf\u1f50\u03ba \u1f00\u03c1\u03b3\u03b5\u1fd6, \u03ba\u03b1\u1f76 \u1f21 \u1f00\u03c0\u03ce\u03bb\u03b5\u03b9\u03b1 \u03b1\u1f50\u03c4\u1ff6\u03bd \u03bf\u1f50 \u2021 \u03bd\u03c5\u03c3\u03c4\u03b1\u03be\u03b5\u03b9 \u00a6 \u03bd\u03c5\u03c3\u03c4\u03b1\u03b6\u03b5\u03b9 \u1d04\u1d1b \u1d1b\u0280 \u03bd\u03c5\u03c3\u03c4\u03ac\u03be\u03b5\u03b9.",
      "4": "\u0395\u1f30 \u03b3\u1f70\u03c1 \u1f41 \u0398\u03b5\u1f78\u03c2 \u1f00\u03b3\u03b3\u03ad\u03bb\u03c9\u03bd \u1f01\u03bc\u03b1\u03c1\u03c4\u03b7\u03c3\u03ac\u03bd\u03c4\u03c9\u03bd \u03bf\u1f50\u03ba \u1f10\u03c6\u03b5\u03af\u03c3\u03b1\u03c4\u03bf \u1f00\u03bb\u03bb\u1f70 \u00a7 \u03c3\u03b5\u03b9\u03c1\u03b1\u03b9\u03c2 \u00a6 \u03c3\u03b5\u03b9\u03c1\u03bf\u03b9\u03c2 \u1d1b\u029c \u1d21\u029c \u03c3\u03b5\u03b9\u03c1\u03b1\u1fd6\u03c2 \u03b6\u03cc\u03c6\u03bf\u03c5 \u03c4\u03b1\u03c1\u03c4\u03b1\u03c1\u03ce\u03c3\u03b1\u03c2 \u03c0\u03b1\u03c1\u03ad\u03b4\u03c9\u03ba\u03b5\u03bd \u03b5\u1f30\u03c2 \u03ba\u03c1\u03af\u03c3\u03b9\u03bd * \u03c4\u03b7\u03c1\u03bf\u03c5\u03bc\u03b5\u03bd\u03bf\u03c5\u03c2 \u00a6 \u03c4\u03b5\u03c4\u03b7\u03c1\u03b7\u03bc\u03b5\u03bd\u03bf\u03c5\u03c2 \u1d1b\u0280 \u03c4\u03b7\u03c1\u03bf\u03c5\u03bc\u03ad\u03bd\u03bf\u03c5\u03c2\u00b7",
      "5": "\u03ba\u03b1\u1f76 \u1f00\u03c1\u03c7\u03b1\u03af\u03bf\u03c5 \u03ba\u03cc\u03c3\u03bc\u03bf\u03c5 \u03bf\u1f50\u03ba \u1f10\u03c6\u03b5\u03af\u03c3\u03b1\u03c4\u03bf, \u2020 \u03b1\u03bb\u03bb\u03b1 \u00a6 \u03b1\u03bb\u03bb \u029c\ua730 \u0274\u1d00 \u1d18\u1d04\u1d0b \u1d1b\u0280 \u1f00\u03bb\u03bb\u1f70 \u1f44\u03b3\u03b4\u03bf\u03bf\u03bd \u039d\u1ff6\u03b5 \u03b4\u03b9\u03ba\u03b1\u03b9\u03bf\u03c3\u03cd\u03bd\u03b7\u03c2 \u03ba\u03ae\u03c1\u03c5\u03ba\u03b1 \u1f10\u03c6\u03cd\u03bb\u03b1\u03be\u03b5, \u03ba\u03b1\u03c4\u03b1\u03ba\u03bb\u03c5\u03c3\u03bc\u1f78\u03bd \u03ba\u03cc\u03c3\u03bc\u1ff3 \u1f00\u03c3\u03b5\u03b2\u1ff6\u03bd \u1f10\u03c0\u03ac\u03be\u03b1\u03c2\u00b7",
      "6": "\u03ba\u03b1\u1f76 \u03c0\u03cc\u03bb\u03b5\u03b9\u03c2 \u03a3\u03bf\u03b4\u03cc\u03bc\u03c9\u03bd \u03ba\u03b1\u1f76 \u0393\u03bf\u03bc\u03cc\u03c1\u03c1\u03b1\u03c2 \u03c4\u03b5\u03c6\u03c1\u03ce\u03c3\u03b1\u03c2 \u2021 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03b7 \u00a6 \u2014 \u1d21\u029c \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u1fc7 \u03ba\u03b1\u03c4\u03ad\u03ba\u03c1\u03b9\u03bd\u03b5\u03bd, \u1f51\u03c0\u03cc\u03b4\u03b5\u03b9\u03b3\u03bc\u03b1 \u03bc\u03b5\u03bb\u03bb\u03cc\u03bd\u03c4\u03c9\u03bd \u00a7 \u03b1\u03c3\u03b5\u03b2\u03b5\u03b9\u03bd \u00a6 \u03b1\u03c3\u03b5\u03b2\u03b5\u03c3\u03b9\u03bd \ua731\u0299\u029f \u1d21\u029c \u1f00\u03c3\u03b5\u03b2\u03b5\u1fd6\u03bd \u03c4\u03b5\u03b8\u03b5\u03b9\u03ba\u03ce\u03c2\u00b7",
      "7": "\u03ba\u03b1\u1f76 \u03b4\u03af\u03ba\u03b1\u03b9\u03bf\u03bd \u039b\u1f7c\u03c4 \u03ba\u03b1\u03c4\u03b1\u03c0\u03bf\u03bd\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf\u03bd \u1f51\u03c0\u1f78 \u03c4\u1fc6\u03c2 \u03c4\u1ff6\u03bd \u1f00\u03b8\u03ad\u03c3\u03bc\u03c9\u03bd \u1f10\u03bd \u1f00\u03c3\u03b5\u03bb\u03b3\u03b5\u03af\u1fb3 \u1f00\u03bd\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u1fc6\u03c2 * \u03b5\u03c1\u03c1\u03c5\u03c3\u03b1\u03c4\u03bf \u00a6 \u03b5\u03c1\u03c5\u03c3\u03b1\u03c4\u03bf \u1d1b\u029c \u1d21\u029c \u1f10\u03c1\u03c1\u03cd\u03c3\u03b1\u03c4\u03bf",
      "8": "(\u03b2\u03bb\u03ad\u03bc\u03bc\u03b1\u03c4\u03b9 \u03b3\u1f70\u03c1 \u03ba\u03b1\u1f76 \u1f00\u03ba\u03bf\u1fc7 \u2020 \u03bf \u00a6 \u2014 \u1d21\u029c \u1f41 \u03b4\u03af\u03ba\u03b1\u03b9\u03bf\u03c2 \u2021 \u03b5\u03b3\u03ba\u03b1\u03c4\u03bf\u03b9\u03ba\u03c9\u03bd \u00a6 \u03b5\u03bd\u03ba\u03b1\u03c4\u03bf\u03b9\u03ba\u03c9\u03bd \u1d1b\u029c \u1d21\u029c \u1f10\u03b3\u03ba\u03b1\u03c4\u03bf\u03b9\u03ba\u1ff6\u03bd \u1f10\u03bd \u03b1\u1f50\u03c4\u03bf\u1fd6\u03c2 \u1f21\u03bc\u03ad\u03c1\u03b1\u03bd \u1f10\u03be \u1f21\u03bc\u03ad\u03c1\u03b1\u03c2 \u03c8\u03c5\u03c7\u1f74\u03bd \u03b4\u03b9\u03ba\u03b1\u03af\u03b1\u03bd \u1f00\u03bd\u03cc\u03bc\u03bf\u03b9\u03c2 \u1f14\u03c1\u03b3\u03bf\u03b9\u03c2 \u1f10\u03b2\u03b1\u03c3\u03ac\u03bd\u03b9\u03b6\u03b5\u03bd)\u2014",
      "9": "\u03bf\u1f36\u03b4\u03b5 \u039a\u03cd\u03c1\u03b9\u03bf\u03c2 \u03b5\u1f50\u03c3\u03b5\u03b2\u03b5\u1fd6\u03c2 \u1f10\u03ba \u00a7 \u03c0\u03b5\u03b9\u03c1\u03b1\u03c3\u03bc\u03bf\u03c5 \u00a6 \u03c0\u03b5\u03b9\u03c1\u03b1\u03c3\u03bc\u03c9\u03bd \u1d18\u1d04\u1d0b \ua731\u1d04\u0280 \u03c0\u03b5\u03b9\u03c1\u03b1\u03c3\u03bc\u03bf\u1fe6 \u1fe5\u03cd\u03b5\u03c3\u03b8\u03b1\u03b9, \u1f00\u03b4\u03af\u03ba\u03bf\u03c5\u03c2 \u03b4\u1f72 \u03b5\u1f30\u03c2 \u1f21\u03bc\u03ad\u03c1\u03b1\u03bd \u03ba\u03c1\u03af\u03c3\u03b5\u03c9\u03c2 \u03ba\u03bf\u03bb\u03b1\u03b6\u03bf\u03bc\u03ad\u03bd\u03bf\u03c5\u03c2 \u03c4\u03b7\u03c1\u03b5\u1fd6\u03bd,",
      "10": "\u03bc\u03ac\u03bb\u03b9\u03c3\u03c4\u03b1 \u03b4\u1f72 \u03c4\u03bf\u1f7a\u03c2 \u1f40\u03c0\u03af\u03c3\u03c9 \u03c3\u03b1\u03c1\u03ba\u1f78\u03c2 \u1f10\u03bd \u1f10\u03c0\u03b9\u03b8\u03c5\u03bc\u03af\u1fb3 \u03bc\u03b9\u03b1\u03c3\u03bc\u03bf\u1fe6 \u03c0\u03bf\u03c1\u03b5\u03c5\u03bf\u03bc\u03ad\u03bd\u03bf\u03c5\u03c2 \u03ba\u03b1\u1f76 \u03ba\u03c5\u03c1\u03b9\u03cc\u03c4\u03b7\u03c4\u03bf\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c6\u03c1\u03bf\u03bd\u03bf\u1fe6\u03bd\u03c4\u03b1\u03c2.",
      "11": "\u1f45\u03c0\u03bf\u03c5 \u1f04\u03b3\u03b3\u03b5\u03bb\u03bf\u03b9 \u1f30\u03c3\u03c7\u03cd\u03ca \u03ba\u03b1\u1f76 \u03b4\u03c5\u03bd\u03ac\u03bc\u03b5\u03b9 \u03bc\u03b5\u03af\u03b6\u03bf\u03bd\u03b5\u03c2 \u1f44\u03bd\u03c4\u03b5\u03c2 \u03bf\u1f50 \u03c6\u03ad\u03c1\u03bf\u03c5\u03c3\u03b9 \u03ba\u03b1\u03c4\u1fbd \u03b1\u1f50\u03c4\u1ff6\u03bd * \u03c0\u03b1\u03c1\u03b1 \u03ba\u03c5\u03c1\u03b9\u03c9 \u00a6 \u2014 \ua731\u0299\u029f \u03c0\u03b1\u03c1\u1f70 \u039a\u03c5\u03c1\u03af\u1ff3 \u03b2\u03bb\u03ac\u03c3\u03c6\u03b7\u03bc\u03bf\u03bd \u03ba\u03c1\u03af\u03c3\u03b9\u03bd.",
      "12": "\u03bf\u1f57\u03c4\u03bf\u03b9 \u03b4\u03ad, \u1f61\u03c2 \u1f04\u03bb\u03bf\u03b3\u03b1 \u03b6\u1ff7\u03b1 \u2020 \u03c6\u03c5\u03c3\u03b9\u03ba\u03b1 \u03b3\u03b5\u03b3\u03b5\u03bd\u03b7\u03bc\u03b5\u03bd\u03b1 \u00a6 \u03b3\u03b5\u03b3\u03b5\u03bd\u03b7\u03bc\u03b5\u03bd\u03b1 \u03c6\u03c5\u03c3\u03b9\u03ba\u03b1 \u1d18\u1d04\u1d0b \u00a6 \u03b3\u03b5\u03b3\u03b5\u03bd\u03bd\u03b7\u03bc\u03b5\u03bd\u03b1 \u03c6\u03c5\u03c3\u03b9\u03ba\u03b1 \u1d04\u1d1b \u03c6\u03c5\u03c3\u03b9\u03ba\u1f70 \u03b3\u03b5\u03b3\u03b5\u03bd\u03b7\u03bc\u03ad\u03bd\u03b1 \u03b5\u1f30\u03c2 \u1f05\u03bb\u03c9\u03c3\u03b9\u03bd \u03ba\u03b1\u1f76 \u03c6\u03b8\u03bf\u03c1\u03ac\u03bd, \u1f10\u03bd \u03bf\u1f37\u03c2 \u1f00\u03b3\u03bd\u03bf\u03bf\u1fe6\u03c3\u03b9 \u03b2\u03bb\u03b1\u03c3\u03c6\u03b7\u03bc\u03bf\u1fe6\u03bd\u03c4\u03b5\u03c2, \u1f10\u03bd \u03c4\u1fc7 \u03c6\u03b8\u03bf\u03c1\u1fb7 \u03b1\u1f50\u03c4\u1ff6\u03bd \u2021 \u03ba\u03b1\u03c4\u03b1\u03c6\u03b8\u03b1\u03c1\u03b7\u03c3\u03bf\u03bd\u03c4\u03b1\u03b9 \u00a6 \u03ba\u03b1\u03b9 \u03ba\u03b1\u03c4\u03b1\u03c6\u03b8\u03b1\u03c1\u03b7\u03c3\u03bf\u03bd\u03c4\u03b1\u03b9 \u029c\ua730 \u00a6 \u03ba\u03b1\u03b9 \u03c6\u03b8\u03b1\u03c1\u03b7\u03c3\u03bf\u03bd\u03c4\u03b1\u03b9 \u1d04\u1d1b \u03ba\u03b1\u03c4\u03b1\u03c6\u03b8\u03b1\u03c1\u03ae\u03c3\u03bf\u03bd\u03c4\u03b1\u03b9,",
      "13": "\u00a7 \u03ba\u03bf\u03bc\u03b9\u03bf\u03c5\u03bc\u03b5\u03bd\u03bf\u03b9 97.6% \u00a6 \u03b1\u03b4\u03b9\u03ba\u03bf\u03c5\u03bc\u03b5\u03bd\u03bf\u03b9 \u0274\u1d00 \ua731\u0299\u029f \u1d21\u029c 2% \u03ba\u03bf\u03bc\u03b9\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf\u03b9 \u03bc\u03b9\u03c3\u03b8\u1f78\u03bd \u1f00\u03b4\u03b9\u03ba\u03af\u03b1\u03c2. \u1f21\u03b4\u03bf\u03bd\u1f74\u03bd \u1f21\u03b3\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf\u03b9 \u03c4\u1f74\u03bd \u1f10\u03bd \u1f21\u03bc\u03ad\u03c1\u1fb3 \u03c4\u03c1\u03c5\u03c6\u03ae\u03bd, \u03c3\u03c0\u03af\u03bb\u03bf\u03b9 \u03ba\u03b1\u1f76 \u03bc\u1ff6\u03bc\u03bf\u03b9, \u1f10\u03bd\u03c4\u03c1\u03c5\u03c6\u1ff6\u03bd\u03c4\u03b5\u03c2 \u1f10\u03bd \u03c4\u03b1\u1fd6\u03c2 \u1f00\u03c0\u03ac\u03c4\u03b1\u03b9\u03c2 \u03b1\u1f50\u03c4\u1ff6\u03bd \u03c3\u03c5\u03bd\u03b5\u03c5\u03c9\u03c7\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf\u03b9 \u1f51\u03bc\u1fd6\u03bd.",
      "14": "\u1f40\u03c6\u03b8\u03b1\u03bb\u03bc\u03bf\u1f7a\u03c2 \u1f14\u03c7\u03bf\u03bd\u03c4\u03b5\u03c2 \u03bc\u03b5\u03c3\u03c4\u03bf\u1f7a\u03c2 \u03bc\u03bf\u03b9\u03c7\u03b1\u03bb\u03af\u03b4\u03bf\u03c2 \u03ba\u03b1\u1f76 * \u03b1\u03ba\u03b1\u03c4\u03b1\u03c0\u03b1\u03c5\u03c3\u03c4\u03bf\u03c5\u03c2 \u00a6 \u03b1\u03ba\u03b1\u03c4\u03b1\u03c0\u03b1\u03c3\u03c4\u03bf\u03c5\u03c2 \u1d21\u029c \u1f00\u03ba\u03b1\u03c4\u03b1\u03c0\u03b1\u03cd\u03c3\u03c4\u03bf\u03c5\u03c2 \u1f01\u03bc\u03b1\u03c1\u03c4\u03af\u03b1\u03c2, \u03b4\u03b5\u03bb\u03b5\u03ac\u03b6\u03bf\u03bd\u03c4\u03b5\u03c2 \u03c8\u03c5\u03c7\u1f70\u03c2 \u1f00\u03c3\u03c4\u03b7\u03c1\u03af\u03ba\u03c4\u03bf\u03c5\u03c2, \u03ba\u03b1\u03c1\u03b4\u03af\u03b1\u03bd \u03b3\u03b5\u03b3\u03c5\u03bc\u03bd\u03b1\u03c3\u03bc\u03ad\u03bd\u03b7\u03bd \u2020 \u03c0\u03bb\u03b5\u03bf\u03bd\u03b5\u03be\u03b9\u03b1\u03c2 \u00a6 \u03c0\u03bb\u03b5\u03bf\u03bd\u03b5\u03be\u03b9\u03b1\u03b9\u03c2 \u1d1b\u0280 \u03c0\u03bb\u03b5\u03bf\u03bd\u03b5\u03be\u03af\u03b1\u03c2 \u1f14\u03c7\u03bf\u03bd\u03c4\u03b5\u03c2, \u03ba\u03b1\u03c4\u03ac\u03c1\u03b1\u03c2 \u03c4\u03ad\u03ba\u03bd\u03b1.",
      "15": "\u2021 \u03ba\u03b1\u03c4\u03b1\u03bb\u03b9\u03c0\u03bf\u03bd\u03c4\u03b5\u03c2 \u00a6 \u03ba\u03b1\u03c4\u03b1\u03bb\u03b5\u03b9\u03c0\u03bf\u03bd\u03c4\u03b5\u03c2 \u1d1b\u029c \u1d21\u029c \u03ba\u03b1\u03c4\u03b1\u03bb\u03b9\u03c0\u03cc\u03bd\u03c4\u03b5\u03c2 \u00a7 \u03b5\u03c5\u03b8\u03b5\u03b9\u03b1\u03bd \u00a6 \u03c4\u03b7\u03bd \u03b5\u03c5\u03b8\u03b5\u03b9\u03b1\u03bd \u1d1b\u0280 \u03b5\u1f50\u03b8\u03b5\u1fd6\u03b1\u03bd \u1f41\u03b4\u1f78\u03bd \u1f10\u03c0\u03bb\u03b1\u03bd\u03ae\u03b8\u03b7\u03c3\u03b1\u03bd, \u1f10\u03be\u03b1\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03ae\u03c3\u03b1\u03bd\u03c4\u03b5\u03c2 \u03c4\u1fc7 \u1f41\u03b4\u1ff7 \u03c4\u03bf\u1fe6 \u0392\u03b1\u03bb\u03b1\u1f70\u03bc \u03c4\u03bf\u1fe6 * \u03b2\u03bf\u03c3\u03bf\u03c1 \u00a6 \u03b2\u03b5\u03c9\u03c1 \u1d21\u029c \u0392\u03bf\u03c3\u03cc\u03c1, \u1f43\u03c2 \u03bc\u03b9\u03c3\u03b8\u1f78\u03bd \u1f00\u03b4\u03b9\u03ba\u03af\u03b1\u03c2 \u1f20\u03b3\u03ac\u03c0\u03b7\u03c3\u03b5\u03bd,",
      "16": "\u1f14\u03bb\u03b5\u03b3\u03be\u03b9\u03bd \u03b4\u1f72 \u1f14\u03c3\u03c7\u03b5\u03bd \u1f30\u03b4\u03af\u03b1\u03c2 \u03c0\u03b1\u03c1\u03b1\u03bd\u03bf\u03bc\u03af\u03b1\u03c2\u00b7 \u1f51\u03c0\u03bf\u03b6\u03cd\u03b3\u03b9\u03bf\u03bd \u1f04\u03c6\u03c9\u03bd\u03bf\u03bd \u1f10\u03bd \u1f00\u03bd\u03b8\u03c1\u03ce\u03c0\u03bf\u03c5 \u03c6\u03c9\u03bd\u1fc7 \u03c6\u03b8\u03b5\u03b3\u03be\u03ac\u03bc\u03b5\u03bd\u03bf\u03bd \u1f10\u03ba\u03ce\u03bb\u03c5\u03c3\u03b5 \u03c4\u1f74\u03bd \u03c4\u03bf\u1fe6 \u03c0\u03c1\u03bf\u03c6\u03ae\u03c4\u03bf\u03c5 \u03c0\u03b1\u03c1\u03b1\u03c6\u03c1\u03bf\u03bd\u03af\u03b1\u03bd.",
      "17": "\u039f\u1f57\u03c4\u03bf\u03af \u03b5\u1f30\u03c3\u03b9 \u03c0\u03b7\u03b3\u03b1\u1f76 \u1f04\u03bd\u03c5\u03b4\u03c1\u03bf\u03b9, \u2020 \u03bd\u03b5\u03c6\u03b5\u03bb\u03b1\u03b9 \u03c5\u03c0\u03bf \u2026 \u03c3\u03ba\u03bf\u03c4\u03bf\u03c5\u03c2 \u03b5\u03b9\u03c2 \u03b1\u03b9\u03c9\u03bd\u03b1 58.9% \u00a6 \u03bd\u03b5\u03c6\u03b5\u03bb\u03b1\u03b9 \u03c5\u03c0\u03bf \u2026 \u03c3\u03ba\u03bf\u03c4\u03bf\u03c5\u03c2 \u03b5\u03b9\u03c2 \u03b1\u03b9\u03c9\u03bd\u03b1\u03c2 \u1d18\u1d04\u1d0b 22.8% \u00a6 \u03ba\u03b1\u03b9 \u03bf\u03bc\u03b9\u03c7\u03bb\u03b1\u03b9 \u03c5\u03c0\u03bf \u2026 \u03c3\u03ba\u03bf\u03c4\u03bf\u03c5\u03c2 \u03b5\u03b9\u03c2 \u03b1\u03b9\u03c9\u03bd\u03b1 \u1d0d\ua731\ua731 5.8% \u00a6 \u03ba\u03b1\u03b9 \u03bf\u03bc\u03b9\u03c7\u03bb\u03b1\u03b9 \u03c5\u03c0\u03bf \u2026 \u03c3\u03ba\u03bf\u03c4\u03bf\u03c5\u03c2 \u1d04\u1d1b 1% \u03bd\u03b5\u03c6\u03ad\u03bb\u03b1\u03b9 \u1f51\u03c0\u1f78 \u03bb\u03b1\u03af\u03bb\u03b1\u03c0\u03bf\u03c2 \u1f10\u03bb\u03b1\u03c5\u03bd\u03cc\u03bc\u03b5\u03bd\u03b1\u03b9, \u03bf\u1f37\u03c2 \u1f41 \u03b6\u03cc\u03c6\u03bf\u03c2 \u03c4\u03bf\u1fe6 \u03c3\u03ba\u03cc\u03c4\u03bf\u03c5\u03c2 \u03b5\u1f30\u03c2 \u03b1\u1f30\u1ff6\u03bd\u03b1 \u03c4\u03b5\u03c4\u03ae\u03c1\u03b7\u03c4\u03b1\u03b9.",
      "18": "\u1f51\u03c0\u03ad\u03c1\u03bf\u03b3\u03ba\u03b1 \u03b3\u1f70\u03c1 \u03bc\u03b1\u03c4\u03b1\u03b9\u03cc\u03c4\u03b7\u03c4\u03bf\u03c2 \u03c6\u03b8\u03b5\u03b3\u03b3\u03cc\u03bc\u03b5\u03bd\u03bf\u03b9 \u03b4\u03b5\u03bb\u03b5\u03ac\u03b6\u03bf\u03c5\u03c3\u03b9\u03bd \u1f10\u03bd \u1f10\u03c0\u03b9\u03b8\u03c5\u03bc\u03af\u03b1\u03b9\u03c2 \u03c3\u03b1\u03c1\u03ba\u1f78\u03c2 \u2021 \u03b1\u03c3\u03b5\u03bb\u03b3\u03b5\u03b9\u03b1\u03b9\u03c2 \u00a6 \u03b1\u03c3\u03b5\u03bb\u03b3\u03b5\u03b9\u03b1\u03c2 \u1d18\u1d04\u1d0b \u00a6 \u03b5\u03bd \u03b1\u03c3\u03b5\u03bb\u03b3\u03b5\u03b9\u03b1\u03b9\u03c2 \ua731\u1d04\u0280 \u1f00\u03c3\u03b5\u03bb\u03b3\u03b5\u03af\u03b1\u03b9\u03c2 \u03c4\u03bf\u1f7a\u03c2 \u00a7 \u03bf\u03bd\u03c4\u03c9\u03c2 \u00a6 \u03bf\u03bb\u03b9\u03b3\u03c9\u03c2 \ua731\u0299\u029f \u1d21\u029c \u1f44\u03bd\u03c4\u03c9\u03c2 * \u03b1\u03c0\u03bf\u03c6\u03c5\u03b3\u03bf\u03bd\u03c4\u03b1\u03c2 \u00a6 \u03b1\u03c0\u03bf\u03c6\u03b5\u03c5\u03b3\u03bf\u03bd\u03c4\u03b1\u03c2 \u1d04\u1d1b \u1f00\u03c0\u03bf\u03c6\u03c5\u03b3\u03cc\u03bd\u03c4\u03b1\u03c2 \u03c4\u03bf\u1f7a\u03c2 \u1f10\u03bd \u03c0\u03bb\u03ac\u03bd\u1fc3 \u1f00\u03bd\u03b1\u03c3\u03c4\u03c1\u03b5\u03c6\u03bf\u03bc\u03ad\u03bd\u03bf\u03c5\u03c2,",
      "19": "\u1f10\u03bb\u03b5\u03c5\u03b8\u03b5\u03c1\u03af\u03b1\u03bd \u03b1\u1f50\u03c4\u03bf\u1fd6\u03c2 \u1f10\u03c0\u03b1\u03b3\u03b3\u03b5\u03bb\u03bb\u03cc\u03bc\u03b5\u03bd\u03bf\u03b9, \u03b1\u1f50\u03c4\u03bf\u1f76 \u03b4\u03bf\u1fe6\u03bb\u03bf\u03b9 \u1f51\u03c0\u03ac\u03c1\u03c7\u03bf\u03bd\u03c4\u03b5\u03c2 \u03c4\u1fc6\u03c2 \u03c6\u03b8\u03bf\u03c1\u1fb6\u03c2\u00b7 \u1fa7 \u03b3\u03ac\u03c1 \u03c4\u03b9\u03c2 \u1f25\u03c4\u03c4\u03b7\u03c4\u03b1\u03b9, \u03c4\u03bf\u03cd\u03c4\u1ff3 \u2020 \u03ba\u03b1\u03b9 \u00a6 \u2014 \u0274\u1d00 \u1d1b\u029c \u1d21\u029c \u03ba\u03b1\u1f76 \u03b4\u03b5\u03b4\u03bf\u03cd\u03bb\u03c9\u03c4\u03b1\u03b9.",
      "20": "\u03b5\u1f30 \u03b3\u1f70\u03c1 \u1f00\u03c0\u03bf\u03c6\u03c5\u03b3\u03cc\u03bd\u03c4\u03b5\u03c2 \u03c4\u1f70 \u03bc\u03b9\u03ac\u03c3\u03bc\u03b1\u03c4\u03b1 \u03c4\u03bf\u1fe6 \u03ba\u03cc\u03c3\u03bc\u03bf\u03c5 \u1f10\u03bd \u1f10\u03c0\u03b9\u03b3\u03bd\u03ce\u03c3\u03b5\u03b9 \u03c4\u03bf\u1fe6 \u039a\u03c5\u03c1\u03af\u03bf\u03c5 \u03ba\u03b1\u1f76 \u03c3\u03c9\u03c4\u1fc6\u03c1\u03bf\u03c2 \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6, \u03c4\u03bf\u03cd\u03c4\u03bf\u03b9\u03c2 \u03b4\u1f72 \u03c0\u03ac\u03bb\u03b9\u03bd \u1f10\u03bc\u03c0\u03bb\u03b1\u03ba\u03ad\u03bd\u03c4\u03b5\u03c2 \u1f21\u03c4\u03c4\u1ff6\u03bd\u03c4\u03b1\u03b9, \u03b3\u03ad\u03b3\u03bf\u03bd\u03b5\u03bd \u03b1\u1f50\u03c4\u03bf\u1fd6\u03c2 \u03c4\u1f70 \u1f14\u03c3\u03c7\u03b1\u03c4\u03b1 \u03c7\u03b5\u03af\u03c1\u03bf\u03bd\u03b1 \u03c4\u1ff6\u03bd \u03c0\u03c1\u03ce\u03c4\u03c9\u03bd.",
      "21": "\u03ba\u03c1\u03b5\u1fd6\u03c4\u03c4\u03bf\u03bd \u03b3\u1f70\u03c1 \u1f26\u03bd \u03b1\u1f50\u03c4\u03bf\u1fd6\u03c2 \u03bc\u1f74 \u1f10\u03c0\u03b5\u03b3\u03bd\u03c9\u03ba\u03ad\u03bd\u03b1\u03b9 \u03c4\u1f74\u03bd \u1f41\u03b4\u1f78\u03bd \u03c4\u1fc6\u03c2 \u03b4\u03b9\u03ba\u03b1\u03b9\u03bf\u03c3\u03cd\u03bd\u03b7\u03c2 \u1f22 \u1f10\u03c0\u03b9\u03b3\u03bd\u03bf\u1fe6\u03c3\u03b9\u03bd \u2021 \u03b5\u03c0\u03b9\u03c3\u03c4\u03c1\u03b5\u03c8\u03b1\u03b9 82.5% \u00a6 \u03c5\u03c0\u03bf\u03c3\u03c4\u03c1\u03b5\u03c8\u03b1\u03b9 \u1d04\u1d1b 4.7% \u1f10\u03c0\u03b9\u03c3\u03c4\u03c1\u03ad\u03c8\u03b1\u03b9 \u1f10\u03ba \u03c4\u1fc6\u03c2 \u03c0\u03b1\u03c1\u03b1\u03b4\u03bf\u03b8\u03b5\u03af\u03c3\u03b7\u03c2 \u03b1\u1f50\u03c4\u03bf\u1fd6\u03c2 \u1f01\u03b3\u03af\u03b1\u03c2 \u1f10\u03bd\u03c4\u03bf\u03bb\u1fc6\u03c2.",
      "22": "\u03c3\u03c5\u03bc\u03b2\u03ad\u03b2\u03b7\u03ba\u03b5 \u00a7 \u03b4\u03b5 \u00a6 \u2014 \u1d04\u1d1b \u03b4\u1f72 \u03b1\u1f50\u03c4\u03bf\u1fd6\u03c2 \u03c4\u1f78 \u03c4\u1fc6\u03c2 \u1f00\u03bb\u03b7\u03b8\u03bf\u1fe6\u03c2 \u03c0\u03b1\u03c1\u03bf\u03b9\u03bc\u03af\u03b1\u03c2\u00b7 \u039a\u03cd\u03c9\u03bd \u1f10\u03c0\u03b9\u03c3\u03c4\u03c1\u03ad\u03c8\u03b1\u03c2 \u1f10\u03c0\u1f76 \u03c4\u1f78 \u1f34\u03b4\u03b9\u03bf\u03bd \u1f10\u03be\u03ad\u03c1\u03b1\u03bc\u03b1, \u03ba\u03b1\u1f76 \u1f57\u03c2 \u03bb\u03bf\u03c5\u03c3\u03b1\u03bc\u03ad\u03bd\u03b7 \u03b5\u1f30\u03c2 * \u03ba\u03c5\u03bb\u03b9\u03c3\u03bc\u03b1 \u00a6 \u03ba\u03c5\u03bb\u03b9\u03c3\u03bc\u03bf\u03bd \u1d04\u1d1b \u03ba\u03cd\u03bb\u03b9\u03c3\u03bc\u03b1 \u03b2\u03bf\u03c1\u03b2\u03cc\u03c1\u03bf\u03c5."
    },
    "3": {
      "1": "\u03a4\u03b1\u03cd\u03c4\u03b7\u03bd \u1f24\u03b4\u03b7, \u1f00\u03b3\u03b1\u03c0\u03b7\u03c4\u03bf\u03af, \u03b4\u03b5\u03c5\u03c4\u03ad\u03c1\u03b1\u03bd \u1f51\u03bc\u1fd6\u03bd \u03b3\u03c1\u03ac\u03c6\u03c9 \u1f10\u03c0\u03b9\u03c3\u03c4\u03bf\u03bb\u03ae\u03bd, \u1f10\u03bd \u03b1\u1f37\u03c2 \u03b4\u03b9\u03b5\u03b3\u03b5\u03af\u03c1\u03c9 \u1f51\u03bc\u1ff6\u03bd \u1f10\u03bd \u1f51\u03c0\u03bf\u03bc\u03bd\u03ae\u03c3\u03b5\u03b9 \u03c4\u1f74\u03bd \u03b5\u1f30\u03bb\u03b9\u03ba\u03c1\u03b9\u03bd\u1fc6 \u03b4\u03b9\u03ac\u03bd\u03bf\u03b9\u03b1\u03bd",
      "2": "\u03bc\u03bd\u03b7\u03c3\u03b8\u1fc6\u03bd\u03b1\u03b9 \u03c4\u1ff6\u03bd \u03c0\u03c1\u03bf\u03b5\u03b9\u03c1\u03b7\u03bc\u03ad\u03bd\u03c9\u03bd \u1fe5\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u1f51\u03c0\u1f78 \u03c4\u1ff6\u03bd \u1f01\u03b3\u03af\u03c9\u03bd \u03c0\u03c1\u03bf\u03c6\u03b7\u03c4\u1ff6\u03bd \u03ba\u03b1\u1f76 \u03c4\u1fc6\u03c2 \u03c4\u1ff6\u03bd \u1f00\u03c0\u03bf\u03c3\u03c4\u03cc\u03bb\u03c9\u03bd * \u03c5\u03bc\u03c9\u03bd \u00a6 \u03b7\u03bc\u03c9\u03bd \u1d1b\u0280 \u1f51\u03bc\u1ff6\u03bd \u1f10\u03bd\u03c4\u03bf\u03bb\u1fc6\u03c2 \u03c4\u03bf\u1fe6 \u039a\u03c5\u03c1\u03af\u03bf\u03c5 \u03ba\u03b1\u1f76 \u03c3\u03c9\u03c4\u1fc6\u03c1\u03bf\u03c2\u00b7",
      "3": "\u03c4\u03bf\u1fe6\u03c4\u03bf \u03c0\u03c1\u1ff6\u03c4\u03bf\u03bd \u03b3\u03b9\u03bd\u03ce\u03c3\u03ba\u03bf\u03bd\u03c4\u03b5\u03c2, \u1f45\u03c4\u03b9 \u1f10\u03bb\u03b5\u03cd\u03c3\u03bf\u03bd\u03c4\u03b1\u03b9 \u1f10\u03c0\u1fbd \u2020 \u03b5\u03c3\u03c7\u03b1\u03c4\u03bf\u03c5 \u00a6 \u03b5\u03c3\u03c7\u03b1\u03c4\u03c9\u03bd \u1d00\u0274\u1d1b \u1d04\u1d1b \u1f10\u03c3\u03c7\u03ac\u03c4\u03bf\u03c5 \u03c4\u1ff6\u03bd \u1f21\u03bc\u03b5\u03c1\u1ff6\u03bd \u2021 \u03b5\u03bc\u03c0\u03b1\u03b9\u03ba\u03c4\u03b1\u03b9 \u00a6 \u03b5\u03bd \u03b5\u03bc\u03c0\u03b1\u03b9\u03b3\u03bc\u03bf\u03bd\u03b7 \u03b5\u03bc\u03c0\u03b1\u03b9\u03ba\u03c4\u03b1\u03b9 \u1d04\u1d1b \u1f10\u03bc\u03c0\u03b1\u1fd6\u03ba\u03c4\u03b1\u03b9 \u03ba\u03b1\u03c4\u1f70 \u03c4\u1f70\u03c2 \u1f30\u03b4\u03af\u03b1\u03c2 \u00a7 \u03b5\u03c0\u03b9\u03b8\u03c5\u03bc\u03b9\u03b1\u03c2 \u03b1\u03c5\u03c4\u03c9\u03bd \u00a6 \u03b1\u03c5\u03c4\u03c9\u03bd \u03b5\u03c0\u03b9\u03b8\u03c5\u03bc\u03b9\u03b1\u03c2 \u1d1b\u0280 \u1f10\u03c0\u03b9\u03b8\u03c5\u03bc\u03af\u03b1\u03c2 \u03b1\u1f50\u03c4\u1ff6\u03bd \u03c0\u03bf\u03c1\u03b5\u03c5\u03cc\u03bc\u03b5\u03bd\u03bf\u03b9",
      "4": "\u03ba\u03b1\u1f76 \u03bb\u03ad\u03b3\u03bf\u03bd\u03c4\u03b5\u03c2, \u03a0\u03bf\u1fe6 \u1f10\u03c3\u03c4\u03b9\u03bd \u1f21 \u1f10\u03c0\u03b1\u03b3\u03b3\u03b5\u03bb\u03af\u03b1 \u03c4\u1fc6\u03c2 \u03c0\u03b1\u03c1\u03bf\u03c5\u03c3\u03af\u03b1\u03c2 \u03b1\u1f50\u03c4\u03bf\u1fe6; \u1f00\u03c6\u1fbd \u1f27\u03c2 \u03b3\u1f70\u03c1 \u03bf\u1f31 \u03c0\u03b1\u03c4\u03ad\u03c1\u03b5\u03c2 \u1f10\u03ba\u03bf\u03b9\u03bc\u03ae\u03b8\u03b7\u03c3\u03b1\u03bd, \u03c0\u03ac\u03bd\u03c4\u03b1 \u03bf\u1f55\u03c4\u03c9 \u03b4\u03b9\u03b1\u03bc\u03ad\u03bd\u03b5\u03b9 \u1f00\u03c0\u1fbd \u1f00\u03c1\u03c7\u1fc6\u03c2 \u03ba\u03c4\u03af\u03c3\u03b5\u03c9\u03c2.",
      "5": "\u03bb\u03b1\u03bd\u03b8\u03ac\u03bd\u03b5\u03b9 \u03b3\u1f70\u03c1 \u03b1\u1f50\u03c4\u03bf\u1f7a\u03c2 \u03c4\u03bf\u1fe6\u03c4\u03bf \u03b8\u03ad\u03bb\u03bf\u03bd\u03c4\u03b1\u03c2, \u1f45\u03c4\u03b9 \u03bf\u1f50\u03c1\u03b1\u03bd\u03bf\u1f76 \u1f26\u03c3\u03b1\u03bd \u1f14\u03ba\u03c0\u03b1\u03bb\u03b1\u03b9 \u03ba\u03b1\u1f76 \u03b3\u1fc6 \u1f10\u03be \u1f55\u03b4\u03b1\u03c4\u03bf\u03c2 \u03ba\u03b1\u1f76 \u03b4\u03b9\u1fbd \u1f55\u03b4\u03b1\u03c4\u03bf\u03c2 * \u03c3\u03c5\u03bd\u03b5\u03c3\u03c4\u03c9\u03c3\u03b1 \u00a6 \u03c3\u03c5\u03bd\u03b5\u03c3\u03c4\u03c9\u03c4\u03b1 \u1d18\u1d04\u1d0b \u03c3\u03c5\u03bd\u03b5\u03c3\u03c4\u1ff6\u03c3\u03b1 \u03c4\u1ff7 \u03c4\u03bf\u1fe6 \u0398\u03b5\u03bf\u1fe6 \u03bb\u03cc\u03b3\u1ff3,",
      "6": "\u03b4\u03b9\u1fbd \u2020 \u03c9\u03bd \u00a6 \u03bf\u03bd \u0274\u1d00 \u1f67\u03bd \u1f41 \u03c4\u03cc\u03c4\u03b5 \u03ba\u03cc\u03c3\u03bc\u03bf\u03c2 \u1f55\u03b4\u03b1\u03c4\u03b9 \u03ba\u03b1\u03c4\u03b1\u03ba\u03bb\u03c5\u03c3\u03b8\u03b5\u1f76\u03c2 \u1f00\u03c0\u03ce\u03bb\u03b5\u03c4\u03bf\u00b7",
      "7": "\u03bf\u1f31 \u03b4\u1f72 \u03bd\u1fe6\u03bd \u03bf\u1f50\u03c1\u03b1\u03bd\u03bf\u1f76 \u03ba\u03b1\u1f76 \u1f21 \u03b3\u1fc6 \u2021 \u03c4\u03c9 \u03b1\u03c5\u03c4\u03bf\u03c5 \u00a6 \u03c4\u03c9 \u03b1\u03c5\u03c4\u03c9 \u1d04\u1d1b \ua731\u1d04\u0280 \u00a6 \u03b1\u03c5\u03c4\u03bf\u03c5 \ua731\u1d1b \u03c4\u1ff7 \u03b1\u1f50\u03c4\u03bf\u1fe6 \u03bb\u03cc\u03b3\u1ff3 \u03c4\u03b5\u03b8\u03b7\u03c3\u03b1\u03c5\u03c1\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf\u03b9 \u03b5\u1f30\u03c3\u03af, \u03c0\u03c5\u03c1\u1f76 \u03c4\u03b7\u03c1\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf\u03b9 \u03b5\u1f30\u03c2 \u1f21\u03bc\u03ad\u03c1\u03b1\u03bd \u03ba\u03c1\u03af\u03c3\u03b5\u03c9\u03c2 \u03ba\u03b1\u1f76 \u1f00\u03c0\u03c9\u03bb\u03b5\u03af\u03b1\u03c2 \u03c4\u1ff6\u03bd \u1f00\u03c3\u03b5\u03b2\u1ff6\u03bd \u1f00\u03bd\u03b8\u03c1\u03ce\u03c0\u03c9\u03bd.",
      "8": "\u1f1b\u03bd \u03b4\u1f72 \u03c4\u03bf\u1fe6\u03c4\u03bf \u03bc\u1f74 \u03bb\u03b1\u03bd\u03b8\u03b1\u03bd\u03ad\u03c4\u03c9 \u1f51\u03bc\u1fb6\u03c2, \u1f00\u03b3\u03b1\u03c0\u03b7\u03c4\u03bf\u03af, \u1f45\u03c4\u03b9 \u03bc\u03af\u03b1 \u1f21\u03bc\u03ad\u03c1\u03b1 \u03c0\u03b1\u03c1\u1f70 \u039a\u03c5\u03c1\u03af\u1ff3 \u1f61\u03c2 \u03c7\u03af\u03bb\u03b9\u03b1 \u1f14\u03c4\u03b7, \u03ba\u03b1\u1f76 \u03c7\u03af\u03bb\u03b9\u03b1 \u1f14\u03c4\u03b7 \u1f61\u03c2 \u1f21\u03bc\u03ad\u03c1\u03b1 \u03bc\u03af\u03b1.",
      "9": "\u03bf\u1f50 \u03b2\u03c1\u03b1\u03b4\u03cd\u03bd\u03b5\u03b9 \u00a7 \u03bf \u00a6 \u2014 \u1d04\u1d1b \u1f41 \u039a\u03cd\u03c1\u03b9\u03bf\u03c2 \u03c4\u1fc6\u03c2 \u1f10\u03c0\u03b1\u03b3\u03b3\u03b5\u03bb\u03af\u03b1\u03c2, \u1f65\u03c2 \u03c4\u03b9\u03bd\u03b5\u03c2 \u03b2\u03c1\u03b1\u03b4\u03c5\u03c4\u1fc6\u03c4\u03b1 \u1f21\u03b3\u03bf\u1fe6\u03bd\u03c4\u03b1\u03b9, \u1f00\u03bb\u03bb\u1f70 \u03bc\u03b1\u03ba\u03c1\u03bf\u03b8\u03c5\u03bc\u03b5\u1fd6 \u03b5\u1f30\u03c2 * \u03b7\u03bc\u03b1\u03c2 \u00a6 \u03c5\u03bc\u03b1\u03c2 \u1d04\u1d1b \u1f21\u03bc\u1fb6\u03c2 \u03bc\u1f74 \u03b2\u03bf\u03c5\u03bb\u03cc\u03bc\u03b5\u03bd\u03cc\u03c2 \u03c4\u03b9\u03bd\u03b1\u03c2 \u1f00\u03c0\u03bf\u03bb\u03ad\u03c3\u03b8\u03b1\u03b9 \u1f00\u03bb\u03bb\u1f70 \u03c0\u03ac\u03bd\u03c4\u03b1\u03c2 \u03b5\u1f30\u03c2 \u03bc\u03b5\u03c4\u03ac\u03bd\u03bf\u03b9\u03b1\u03bd \u03c7\u03c9\u03c1\u1fc6\u03c3\u03b1\u03b9.",
      "10": "\u1f25\u03be\u03b5\u03b9 \u03b4\u1f72 \u2020 \u03b7 \u00a6 \u2014 \u1d04\u1d1b \u1f21 \u1f21\u03bc\u03ad\u03c1\u03b1 \u039a\u03c5\u03c1\u03af\u03bf\u03c5 \u1f61\u03c2 \u03ba\u03bb\u03ad\u03c0\u03c4\u03b7\u03c2 \u2021 \u03b5\u03bd \u03bd\u03c5\u03ba\u03c4\u03b9 87.9% \u00a6 \u2014 \u1d04\u1d1b 12.1% \u1f10\u03bd \u03bd\u03c5\u03ba\u03c4\u03af, \u1f10\u03bd \u1f97 \u00a7 \u03bf\u03b9 \u00a6 \u2014 \u1d00\u0274\u1d1b \u1d18\u1d04\u1d0b \u03bf\u1f31 \u03bf\u1f50\u03c1\u03b1\u03bd\u03bf\u1f76 \u1fe5\u03bf\u03b9\u03b6\u03b7\u03b4\u1f78\u03bd \u03c0\u03b1\u03c1\u03b5\u03bb\u03b5\u03cd\u03c3\u03bf\u03bd\u03c4\u03b1\u03b9, \u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u1fd6\u03b1 \u03b4\u1f72 \u03ba\u03b1\u03c5\u03c3\u03bf\u03cd\u03bc\u03b5\u03bd\u03b1 * \u03bb\u03c5\u03b8\u03b7\u03c3\u03bf\u03bd\u03c4\u03b1\u03b9 \u00a6 \u03bb\u03c5\u03b8\u03b7\u03c3\u03b5\u03c4\u03b1\u03b9 \u1d04\u1d1b \u03bb\u03c5\u03b8\u03ae\u03c3\u03bf\u03bd\u03c4\u03b1\u03b9, \u03ba\u03b1\u1f76 \u03b3\u1fc6 \u03ba\u03b1\u1f76 \u03c4\u1f70 \u1f10\u03bd \u03b1\u1f50\u03c4\u1fc7 \u1f14\u03c1\u03b3\u03b1 \u2020 \u03ba\u03b1\u03c4\u03b1\u03ba\u03b1\u03b7\u03c3\u03b5\u03c4\u03b1\u03b9 89.6% \u00a6 \u03b5\u03c5\u03c1\u03b5\u03b8\u03b7\u03c3\u03b5\u03c4\u03b1\u03b9 \ua731\u0299\u029f \u1d1b\u029c \u1d21\u029c 3.1% \u00a6 \u03bf\u03c5\u03c7 \u03b5\u03c5\u03c1\u03b5\u03b8\u03b7\u03c3\u03b5\u03c4\u03b1\u03b9 \u0274\u1d00 0% \u03ba\u03b1\u03c4\u03b1\u03ba\u03b1\u03ae\u03c3\u03b5\u03c4\u03b1\u03b9.",
      "11": "\u03a4\u03bf\u03cd\u03c4\u03c9\u03bd \u2021 \u03bf\u03c5\u03bd 86% \u00a6 \u03bf\u03c5\u03c4\u03c9 \u0274\u1d00 \ua731\u0299\u029f \u1d21\u029c 4.8% \u03bf\u1f56\u03bd \u03c0\u03ac\u03bd\u03c4\u03c9\u03bd \u03bb\u03c5\u03bf\u03bc\u03ad\u03bd\u03c9\u03bd, \u03c0\u03bf\u03c4\u03b1\u03c0\u03bf\u1f7a\u03c2 \u03b4\u03b5\u1fd6 \u1f51\u03c0\u03ac\u03c1\u03c7\u03b5\u03b9\u03bd \u1f51\u03bc\u1fb6\u03c2 \u1f10\u03bd \u1f01\u03b3\u03af\u03b1\u03b9\u03c2 \u1f00\u03bd\u03b1\u03c3\u03c4\u03c1\u03bf\u03c6\u03b1\u1fd6\u03c2 \u03ba\u03b1\u1f76 \u03b5\u1f50\u03c3\u03b5\u03b2\u03b5\u03af\u03b1\u03b9\u03c2,",
      "12": "\u03c0\u03c1\u03bf\u03c3\u03b4\u03bf\u03ba\u1ff6\u03bd\u03c4\u03b1\u03c2 \u03ba\u03b1\u1f76 \u03c3\u03c0\u03b5\u03cd\u03b4\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c4\u1f74\u03bd \u03c0\u03b1\u03c1\u03bf\u03c5\u03c3\u03af\u03b1\u03bd \u03c4\u1fc6\u03c2 \u03c4\u03bf\u1fe6 \u0398\u03b5\u03bf\u1fe6 \u1f21\u03bc\u03ad\u03c1\u03b1\u03c2, \u03b4\u03b9\u1fbd \u1f23\u03bd \u03bf\u1f50\u03c1\u03b1\u03bd\u03bf\u1f76 \u03c0\u03c5\u03c1\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf\u03b9 \u03bb\u03c5\u03b8\u03ae\u03c3\u03bf\u03bd\u03c4\u03b1\u03b9 \u03ba\u03b1\u1f76 \u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u1fd6\u03b1 \u03ba\u03b1\u03c5\u03c3\u03bf\u03cd\u03bc\u03b5\u03bd\u03b1 \u03c4\u03ae\u03ba\u03b5\u03c4\u03b1\u03b9;",
      "13": "\u03ba\u03b1\u03b9\u03bd\u03bf\u1f7a\u03c2 \u03b4\u1f72 \u03bf\u1f50\u03c1\u03b1\u03bd\u03bf\u1f7a\u03c2 \u03ba\u03b1\u1f76 \u03b3\u1fc6\u03bd \u03ba\u03b1\u03b9\u03bd\u1f74\u03bd \u03ba\u03b1\u03c4\u1f70 \u03c4\u1f78 \u1f10\u03c0\u03ac\u03b3\u03b3\u03b5\u03bb\u03bc\u03b1 \u03b1\u1f50\u03c4\u03bf\u1fe6 \u03c0\u03c1\u03bf\u03c3\u03b4\u03bf\u03ba\u1ff6\u03bc\u03b5\u03bd, \u1f10\u03bd \u03bf\u1f37\u03c2 \u03b4\u03b9\u03ba\u03b1\u03b9\u03bf\u03c3\u03cd\u03bd\u03b7 \u03ba\u03b1\u03c4\u03bf\u03b9\u03ba\u03b5\u1fd6.",
      "14": "\u0394\u03b9\u03cc, \u1f00\u03b3\u03b1\u03c0\u03b7\u03c4\u03bf\u03af, \u03c4\u03b1\u1fe6\u03c4\u03b1 \u03c0\u03c1\u03bf\u03c3\u03b4\u03bf\u03ba\u1ff6\u03bd\u03c4\u03b5\u03c2 \u03c3\u03c0\u03bf\u03c5\u03b4\u03ac\u03c3\u03b1\u03c4\u03b5 \u1f04\u03c3\u03c0\u03b9\u03bb\u03bf\u03b9 \u03ba\u03b1\u1f76 \u1f00\u03bc\u03ce\u03bc\u03b7\u03c4\u03bf\u03b9 \u03b1\u1f50\u03c4\u1ff7 \u03b5\u1f51\u03c1\u03b5\u03b8\u1fc6\u03bd\u03b1\u03b9 \u1f10\u03bd \u03b5\u1f30\u03c1\u03ae\u03bd\u1fc3.",
      "15": "\u03ba\u03b1\u1f76 \u03c4\u1f74\u03bd \u03c4\u03bf\u1fe6 \u039a\u03c5\u03c1\u03af\u03bf\u03c5 \u1f21\u03bc\u1ff6\u03bd \u03bc\u03b1\u03ba\u03c1\u03bf\u03b8\u03c5\u03bc\u03af\u03b1\u03bd \u03c3\u03c9\u03c4\u03b7\u03c1\u03af\u03b1\u03bd \u1f21\u03b3\u03b5\u1fd6\u03c3\u03b8\u03b5, \u03ba\u03b1\u03b8\u1f7c\u03c2 \u03ba\u03b1\u1f76 \u1f41 \u1f00\u03b3\u03b1\u03c0\u03b7\u03c4\u1f78\u03c2 \u1f21\u03bc\u1ff6\u03bd \u1f00\u03b4\u03b5\u03bb\u03c6\u1f78\u03c2 \u03a0\u03b1\u1fe6\u03bb\u03bf\u03c2 \u03ba\u03b1\u03c4\u1f70 \u03c4\u1f74\u03bd \u00a7 \u03b1\u03c5\u03c4\u03c9 \u03b4\u03bf\u03b8\u03b5\u03b9\u03c3\u03b1\u03bd \u00a6 \u03b4\u03bf\u03b8\u03b5\u03b9\u03c3\u03b1\u03bd \u03b1\u03c5\u03c4\u03c9 \u1d04\u1d1b \u03b1\u1f50\u03c4\u1ff7 \u03b4\u03bf\u03b8\u03b5\u1fd6\u03c3\u03b1\u03bd \u03c3\u03bf\u03c6\u03af\u03b1\u03bd \u1f14\u03b3\u03c1\u03b1\u03c8\u03b5\u03bd \u1f51\u03bc\u1fd6\u03bd,",
      "16": "\u1f61\u03c2 \u03ba\u03b1\u1f76 \u1f10\u03bd \u03c0\u03ac\u03c3\u03b1\u03b9\u03c2 * \u03c4\u03b1\u03b9\u03c2 96.2% \u00a6 \u2014 \u1d1b\u029c \u1d21\u029c 2.8% \u03c4\u03b1\u1fd6\u03c2 \u1f10\u03c0\u03b9\u03c3\u03c4\u03bf\u03bb\u03b1\u1fd6\u03c2 \u03bb\u03b1\u03bb\u1ff6\u03bd \u1f10\u03bd \u03b1\u1f50\u03c4\u03b1\u1fd6\u03c2 \u03c0\u03b5\u03c1\u1f76 \u03c4\u03bf\u03cd\u03c4\u03c9\u03bd, \u1f10\u03bd \u2020 \u03bf\u03b9\u03c2 \u00a6 \u03b1\u03b9\u03c2 \u1d04\u1d1b \u03bf\u1f37\u03c2 \u2021 \u03b5\u03c3\u03c4\u03b9 \u00a6 \u03b5\u03b9\u03c3\u03b9 \u1d18\u1d04\u1d0b \u1f10\u03c3\u03c4\u03b9 \u03b4\u03c5\u03c3\u03bd\u03cc\u03b7\u03c4\u03ac \u03c4\u03b9\u03bd\u03b1, \u1f03 \u03bf\u1f31 \u1f00\u03bc\u03b1\u03b8\u03b5\u1fd6\u03c2 \u03ba\u03b1\u1f76 \u1f00\u03c3\u03c4\u03ae\u03c1\u03b9\u03ba\u03c4\u03bf\u03b9 \u00a7 \u03c3\u03c4\u03c1\u03b5\u03b2\u03bb\u03bf\u03c5\u03c3\u03b9\u03bd \u00a6 \u03c3\u03c4\u03c1\u03b5\u03b2\u03bb\u03c9\u03c3\u03bf\u03c5\u03c3\u03b9\u03bd \u0274\u1d00 \u03c3\u03c4\u03c1\u03b5\u03b2\u03bb\u03bf\u1fe6\u03c3\u03b9\u03bd, \u1f61\u03c2 \u03ba\u03b1\u1f76 \u03c4\u1f70\u03c2 \u03bb\u03bf\u03b9\u03c0\u1f70\u03c2 \u03b3\u03c1\u03b1\u03c6\u03ac\u03c2, \u03c0\u03c1\u1f78\u03c2 \u03c4\u1f74\u03bd \u1f30\u03b4\u03af\u03b1\u03bd \u03b1\u1f50\u03c4\u1ff6\u03bd \u1f00\u03c0\u03ce\u03bb\u03b5\u03b9\u03b1\u03bd.",
      "17": "\u1f51\u03bc\u03b5\u1fd6\u03c2 \u03bf\u1f56\u03bd, \u1f00\u03b3\u03b1\u03c0\u03b7\u03c4\u03bf\u03af, \u03c0\u03c1\u03bf\u03b3\u03b9\u03bd\u03ce\u03c3\u03ba\u03bf\u03bd\u03c4\u03b5\u03c2 \u03c6\u03c5\u03bb\u03ac\u03c3\u03c3\u03b5\u03c3\u03b8\u03b5, \u1f35\u03bd\u03b1 \u03bc\u1f74 \u03c4\u1fc7 \u03c4\u1ff6\u03bd \u1f00\u03b8\u03ad\u03c3\u03bc\u03c9\u03bd \u03c0\u03bb\u03ac\u03bd\u1fc3 \u03c3\u03c5\u03bd\u03b1\u03c0\u03b1\u03c7\u03b8\u03ad\u03bd\u03c4\u03b5\u03c2 \u1f10\u03ba\u03c0\u03ad\u03c3\u03b7\u03c4\u03b5 \u03c4\u03bf\u1fe6 \u1f30\u03b4\u03af\u03bf\u03c5 \u03c3\u03c4\u03b7\u03c1\u03b9\u03b3\u03bc\u03bf\u1fe6.",
      "18": "* \u03b1\u03c5\u03be\u03b1\u03bd\u03b5\u03c4\u03b5 \u00a6 \u03b1\u03c5\u03be\u03b1\u03bd\u03b7\u03c4\u03b5 \u1d18\u1d04\u1d0b \u03b1\u1f50\u03be\u03ac\u03bd\u03b5\u03c4\u03b5 \u03b4\u1f72 \u1f10\u03bd \u03c7\u03ac\u03c1\u03b9\u03c4\u03b9 \u03ba\u03b1\u1f76 \u03b3\u03bd\u03ce\u03c3\u03b5\u03b9 \u03c4\u03bf\u1fe6 \u039a\u03c5\u03c1\u03af\u03bf\u03c5 \u1f21\u03bc\u1ff6\u03bd \u03ba\u03b1\u1f76 \u03c3\u03c9\u03c4\u1fc6\u03c1\u03bf\u03c2 \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6. \u03b1\u1f50\u03c4\u1ff7 \u1f21 \u03b4\u03cc\u03be\u03b1 \u03ba\u03b1\u1f76 \u03bd\u1fe6\u03bd \u03ba\u03b1\u1f76 \u03b5\u1f30\u03c2 \u1f21\u03bc\u03ad\u03c1\u03b1\u03bd \u03b1\u1f30\u1ff6\u03bd\u03bf\u03c2."
    }
  }
}