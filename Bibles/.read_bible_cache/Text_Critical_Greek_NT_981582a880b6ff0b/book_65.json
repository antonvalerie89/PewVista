  "source_name": "Text-Critical Greek NT",
  "chapters": {
    "1": {
      "1": "\u1f38\u03bf\u03cd\u03b4\u03b1\u03c2, \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6 \u03b4\u03bf\u1fe6\u03bb\u03bf\u03c2, \u1f00\u03b4\u03b5\u03bb\u03c6\u1f78\u03c2 \u03b4\u1f72 \u1f38\u03b1\u03ba\u03ce\u03b2\u03bf\u03c5, \u03c4\u03bf\u1fd6\u03c2 \u1f10\u03bd \u0398\u03b5\u1ff7 \u03c0\u03b1\u03c4\u03c1\u1f76 * \u03b7\u03b3\u03b9\u03b1\u03c3\u03bc\u03b5\u03bd\u03bf\u03b9\u03c2 90.2% \u00a6 \u03b7\u03b3\u03b1\u03c0\u03b7\u03bc\u03b5\u03bd\u03bf\u03b9\u03c2 \u1d04\u1d1b 8.9% \u1f21\u03b3\u03b9\u03b1\u03c3\u03bc\u03ad\u03bd\u03bf\u03b9\u03c2 \u03ba\u03b1\u1f76 \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u1ff7 \u03c4\u03b5\u03c4\u03b7\u03c1\u03b7\u03bc\u03ad\u03bd\u03bf\u03b9\u03c2, \u03ba\u03bb\u03b7\u03c4\u03bf\u1fd6\u03c2\u00b7",
      "2": "\u1f14\u03bb\u03b5\u03bf\u03c2 \u1f51\u03bc\u1fd6\u03bd \u03ba\u03b1\u1f76 \u03b5\u1f30\u03c1\u03ae\u03bd\u03b7 \u03ba\u03b1\u1f76 \u1f00\u03b3\u03ac\u03c0\u03b7 \u03c0\u03bb\u03b7\u03b8\u03c5\u03bd\u03b8\u03b5\u03af\u03b7.",
      "3": "\u1f08\u03b3\u03b1\u03c0\u03b7\u03c4\u03bf\u03af, \u03c0\u1fb6\u03c3\u03b1\u03bd \u03c3\u03c0\u03bf\u03c5\u03b4\u1f74\u03bd \u03c0\u03bf\u03b9\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf\u03c2 \u03b3\u03c1\u03ac\u03c6\u03b5\u03b9\u03bd \u1f51\u03bc\u1fd6\u03bd \u03c0\u03b5\u03c1\u1f76 \u03c4\u1fc6\u03c2 \u2020 \u03ba\u03bf\u03b9\u03bd\u03b7\u03c2 83.7% \u00a6 \u03ba\u03bf\u03b9\u03bd\u03b7\u03c2 \u03b7\u03bc\u03c9\u03bd \u1d04\u1d1b 11.1% \u03ba\u03bf\u03b9\u03bd\u1fc6\u03c2 \u03c3\u03c9\u03c4\u03b7\u03c1\u03af\u03b1\u03c2, \u1f00\u03bd\u03ac\u03b3\u03ba\u03b7\u03bd \u1f14\u03c3\u03c7\u03bf\u03bd \u03b3\u03c1\u03ac\u03c8\u03b1\u03b9 \u1f51\u03bc\u1fd6\u03bd \u03c0\u03b1\u03c1\u03b1\u03ba\u03b1\u03bb\u1ff6\u03bd \u1f10\u03c0\u03b1\u03b3\u03c9\u03bd\u03af\u03b6\u03b5\u03c3\u03b8\u03b1\u03b9 \u03c4\u1fc7 \u1f05\u03c0\u03b1\u03be \u03c0\u03b1\u03c1\u03b1\u03b4\u03bf\u03b8\u03b5\u03af\u03c3\u1fc3 \u03c4\u03bf\u1fd6\u03c2 \u1f01\u03b3\u03af\u03bf\u03b9\u03c2 \u03c0\u03af\u03c3\u03c4\u03b5\u03b9.",
      "4": "\u2021 \u03c0\u03b1\u03c1\u03b5\u03b9\u03c3\u03b5\u03b4\u03c5\u03c3\u03b1\u03bd 98.2% \u00a6 \u03c0\u03b1\u03c1\u03b5\u03b9\u03c3\u03b5\u03b4\u03c5\u03b7\u03c3\u03b1\u03bd \u1d21\u029c 0.4% \u03c0\u03b1\u03c1\u03b5\u03b9\u03c3\u03ad\u03b4\u03c5\u03c3\u03b1\u03bd \u03b3\u03ac\u03c1 \u03c4\u03b9\u03bd\u03b5\u03c2 \u1f04\u03bd\u03b8\u03c1\u03c9\u03c0\u03bf\u03b9, \u03bf\u1f31 \u03c0\u03ac\u03bb\u03b1\u03b9 \u03c0\u03c1\u03bf\u03b3\u03b5\u03b3\u03c1\u03b1\u03bc\u03bc\u03ad\u03bd\u03bf\u03b9 \u03b5\u1f30\u03c2 \u03c4\u03bf\u1fe6\u03c4\u03bf \u03c4\u1f78 \u03ba\u03c1\u03af\u03bc\u03b1, \u1f00\u03c3\u03b5\u03b2\u03b5\u1fd6\u03c2, \u03c4\u1f74\u03bd \u03c4\u03bf\u1fe6 \u0398\u03b5\u03bf\u1fe6 \u1f21\u03bc\u1ff6\u03bd \u00a7 \u03c7\u03b1\u03c1\u03b9\u03bd 99.3% \u00a6 \u03c7\u03b1\u03c1\u03b9\u03c4\u03b1 \u1d04\u1d1b 0.7% \u03c7\u03ac\u03c1\u03b9\u03bd \u03bc\u03b5\u03c4\u03b1\u03c4\u03b9\u03b8\u03ad\u03bd\u03c4\u03b5\u03c2 \u03b5\u1f30\u03c2 \u1f00\u03c3\u03ad\u03bb\u03b3\u03b5\u03b9\u03b1\u03bd \u03ba\u03b1\u1f76 \u03c4\u1f78\u03bd \u03bc\u03cc\u03bd\u03bf\u03bd \u03b4\u03b5\u03c3\u03c0\u03cc\u03c4\u03b7\u03bd * \u03b8\u03b5\u03bf\u03bd 78.7% \u00a6 \u2014 \u1d00\u0274\u1d1b \u1d04\u1d1b 12.9% \u0398\u03b5\u1f78\u03bd \u03ba\u03b1\u1f76 \u039a\u03cd\u03c1\u03b9\u03bf\u03bd \u1f21\u03bc\u1ff6\u03bd \u1f38\u03b7\u03c3\u03bf\u1fe6\u03bd \u03a7\u03c1\u03b9\u03c3\u03c4\u1f78\u03bd \u1f00\u03c1\u03bd\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf\u03b9.",
      "5": "\u1f59\u03c0\u03bf\u03bc\u03bd\u1fc6\u03c3\u03b1\u03b9 \u03b4\u1f72 \u1f51\u03bc\u1fb6\u03c2 \u03b2\u03bf\u03cd\u03bb\u03bf\u03bc\u03b1\u03b9, \u03b5\u1f30\u03b4\u03cc\u03c4\u03b1\u03c2 \u2020 \u03c5\u03bc\u03b1\u03c2 \u03b1\u03c0\u03b1\u03be \u03c4\u03bf\u03c5\u03c4\u03bf \u03bf\u03c4\u03b9 \u03bf \u03ba\u03c5\u03c1\u03b9\u03bf\u03c2 69.4% \u00a6 \u03b1\u03c0\u03b1\u03be \u03c4\u03bf\u03c5\u03c4\u03bf \u03bf\u03c4\u03b9 \u03bf \u03ba\u03c5\u03c1\u03b9\u03bf\u03c2 \u1d0d\ua731\ua731 6.7% \u00a6 \u03c5\u03bc\u03b1\u03c2 \u03c4\u03bf\u03c5\u03c4\u03bf \u03b1\u03c0\u03b1\u03be \u03bf\u03c4\u03b9 \u03bf \u03ba\u03c5\u03c1\u03b9\u03bf\u03c2 \u1d0d\ua731\ua731 5.4% \u00a6 \u03c5\u03bc\u03b1\u03c2 \u03b1\u03c0\u03b1\u03be \u03c0\u03b1\u03bd\u03c4\u03b1 \u03bf\u03c4\u03b9 \u03b9\u03b7\u03c3\u03bf\u03c5\u03c2 \u0274\u1d00 \ua731\u0299\u029f 0.2% \u00a6 \u03b1\u03c0\u03b1\u03be \u03c0\u03b1\u03bd\u03c4\u03b1 \u03bf\u03c4\u03b9 \u03b9\u03b7\u03c3\u03bf\u03c5\u03c2 \u1d1b\u029c 0.2% \u00a6 \u03b1\u03c0\u03b1\u03be \u03c0\u03b1\u03bd\u03c4\u03b1 \u03bf\u03c4\u03b9 \u03ba\u03c5\u03c1\u03b9\u03bf\u03c2 \u1d21\u029c 0% \u1f51\u03bc\u1fb6\u03c2 \u1f05\u03c0\u03b1\u03be \u03c4\u03bf\u1fe6\u03c4\u03bf, \u1f45\u03c4\u03b9 \u1f41 \u039a\u03cd\u03c1\u03b9\u03bf\u03c2 \u03bb\u03b1\u1f78\u03bd \u1f10\u03ba \u03b3\u1fc6\u03c2 \u0391\u1f30\u03b3\u03cd\u03c0\u03c4\u03bf\u03c5 \u03c3\u03ce\u03c3\u03b1\u03c2, \u03c4\u1f78 \u03b4\u03b5\u03cd\u03c4\u03b5\u03c1\u03bf\u03bd \u03c4\u03bf\u1f7a\u03c2 \u03bc\u1f74 \u03c0\u03b9\u03c3\u03c4\u03b5\u03cd\u03c3\u03b1\u03bd\u03c4\u03b1\u03c2 \u1f00\u03c0\u03ce\u03bb\u03b5\u03c3\u03b5\u03bd.",
      "6": "\u1f00\u03b3\u03b3\u03ad\u03bb\u03bf\u03c5\u03c2 \u03c4\u03b5 \u03c4\u03bf\u1f7a\u03c2 \u03bc\u1f74 \u03c4\u03b7\u03c1\u03ae\u03c3\u03b1\u03bd\u03c4\u03b1\u03c2 \u03c4\u1f74\u03bd \u1f11\u03b1\u03c5\u03c4\u1ff6\u03bd \u1f00\u03c1\u03c7\u03ae\u03bd, \u2021 \u03b1\u03bb\u03bb\u03b1 \u00a6 \u03b1\u03bb\u03bb \u0274\u1d00 \u1d18\u1d04\u1d0b \u1f00\u03bb\u03bb\u1f70 \u1f00\u03c0\u03bf\u03bb\u03b9\u03c0\u03cc\u03bd\u03c4\u03b1\u03c2 \u03c4\u1f78 \u1f34\u03b4\u03b9\u03bf\u03bd \u03bf\u1f30\u03ba\u03b7\u03c4\u03ae\u03c1\u03b9\u03bf\u03bd, \u03b5\u1f30\u03c2 \u03ba\u03c1\u03af\u03c3\u03b9\u03bd \u03bc\u03b5\u03b3\u03ac\u03bb\u03b7\u03c2 \u1f21\u03bc\u03ad\u03c1\u03b1\u03c2 \u03b4\u03b5\u03c3\u03bc\u03bf\u1fd6\u03c2 \u1f00\u03ca\u03b4\u03af\u03bf\u03b9\u03c2 \u1f51\u03c0\u1f78 \u03b6\u03cc\u03c6\u03bf\u03bd \u03c4\u03b5\u03c4\u03ae\u03c1\u03b7\u03ba\u03b5\u03bd\u00b7",
      "7": "\u1f61\u03c2 \u03a3\u03cc\u03b4\u03bf\u03bc\u03b1 \u03ba\u03b1\u1f76 \u0393\u03cc\u03bc\u03bf\u03c1\u03c1\u03b1 \u03ba\u03b1\u1f76 \u03b1\u1f31 \u03c0\u03b5\u03c1\u1f76 \u03b1\u1f50\u03c4\u1f70\u03c2 \u03c0\u03cc\u03bb\u03b5\u03b9\u03c2, \u03c4\u1f78\u03bd \u1f45\u03bc\u03bf\u03b9\u03bf\u03bd \u00a7 \u03c4\u03bf\u03c5\u03c4\u03bf\u03b9\u03c2 \u03c4\u03c1\u03bf\u03c0\u03bf\u03bd 84.1% \u00a6 \u03c4\u03c1\u03bf\u03c0\u03bf\u03bd \u03c4\u03bf\u03c5\u03c4\u03bf\u03b9\u03c2 \u1d04\u1d1b 8.4% \u03c4\u03bf\u03cd\u03c4\u03bf\u03b9\u03c2 \u03c4\u03c1\u03cc\u03c0\u03bf\u03bd \u1f10\u03ba\u03c0\u03bf\u03c1\u03bd\u03b5\u03cd\u03c3\u03b1\u03c3\u03b1\u03b9 \u03ba\u03b1\u1f76 \u1f00\u03c0\u03b5\u03bb\u03b8\u03bf\u1fe6\u03c3\u03b1\u03b9 \u1f40\u03c0\u03af\u03c3\u03c9 \u03c3\u03b1\u03c1\u03ba\u1f78\u03c2 \u1f11\u03c4\u03ad\u03c1\u03b1\u03c2, \u03c0\u03c1\u03cc\u03ba\u03b5\u03b9\u03bd\u03c4\u03b1\u03b9 \u03b4\u03b5\u1fd6\u03b3\u03bc\u03b1 \u03c0\u03c5\u03c1\u1f78\u03c2 \u03b1\u1f30\u03c9\u03bd\u03af\u03bf\u03c5 \u03b4\u03af\u03ba\u03b7\u03bd \u1f51\u03c0\u03ad\u03c7\u03bf\u03c5\u03c3\u03b1\u03b9.",
      "8": "\u1f49\u03bc\u03bf\u03af\u03c9\u03c2 \u03bc\u03ad\u03bd\u03c4\u03bf\u03b9 \u03ba\u03b1\u1f76 \u03bf\u1f57\u03c4\u03bf\u03b9 \u1f10\u03bd\u03c5\u03c0\u03bd\u03b9\u03b1\u03b6\u03cc\u03bc\u03b5\u03bd\u03bf\u03b9 \u03c3\u03ac\u03c1\u03ba\u03b1 \u03bc\u1f72\u03bd \u03bc\u03b9\u03b1\u03af\u03bd\u03bf\u03c5\u03c3\u03b9, \u03ba\u03c5\u03c1\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b4\u1f72 \u1f00\u03b8\u03b5\u03c4\u03bf\u1fe6\u03c3\u03b9, \u03b4\u03cc\u03be\u03b1\u03c2 \u03b4\u1f72 \u03b2\u03bb\u03b1\u03c3\u03c6\u03b7\u03bc\u03bf\u1fe6\u03c3\u03b9\u03bd.",
      "9": "\u1f41 \u03b4\u1f72 \u039c\u03b9\u03c7\u03b1\u1f74\u03bb \u1f41 \u1f00\u03c1\u03c7\u03ac\u03b3\u03b3\u03b5\u03bb\u03bf\u03c2, \u1f45\u03c4\u03b5 \u03c4\u1ff7 \u03b4\u03b9\u03b1\u03b2\u03cc\u03bb\u1ff3 \u03b4\u03b9\u03b1\u03ba\u03c1\u03b9\u03bd\u03cc\u03bc\u03b5\u03bd\u03bf\u03c2 \u03b4\u03b9\u03b5\u03bb\u03ad\u03b3\u03b5\u03c4\u03bf \u03c0\u03b5\u03c1\u1f76 \u03c4\u03bf\u1fe6 * \u03bc\u03c9\u03c3\u03b5\u03c9\u03c2 60.1% \u00a6 \u03bc\u03c9\u03c5\u03c3\u03b5\u03c9\u03c2 \u1d04\u1d1b \u0280\u1d18 36.4% \u039c\u03c9\u03c3\u03ad\u03c9\u03c2 \u03c3\u03ce\u03bc\u03b1\u03c4\u03bf\u03c2, \u03bf\u1f50\u03ba \u1f10\u03c4\u03cc\u03bb\u03bc\u03b7\u03c3\u03b5 \u03ba\u03c1\u03af\u03c3\u03b9\u03bd \u1f10\u03c0\u03b5\u03bd\u03b5\u03b3\u03ba\u03b5\u1fd6\u03bd \u03b2\u03bb\u03b1\u03c3\u03c6\u03b7\u03bc\u03af\u03b1\u03c2 \u2020 \u03b1\u03bb\u03bb \u00a6 \u03b1\u03bb\u03bb\u03b1 \ua731\u0299\u029f \u1d1b\u029c \u1d21\u029c \u1f00\u03bb\u03bb\u1fbd \u03b5\u1f36\u03c0\u03b5\u03bd, \u1f18\u03c0\u03b9\u03c4\u03b9\u03bc\u03ae\u03c3\u03b1\u03b9 \u03c3\u03bf\u03b9 \u039a\u03cd\u03c1\u03b9\u03bf\u03c2.",
      "10": "\u03bf\u1f57\u03c4\u03bf\u03b9 \u03b4\u1f72 \u1f45\u03c3\u03b1 \u03bc\u1f72\u03bd \u03bf\u1f50\u03ba \u03bf\u1f34\u03b4\u03b1\u03c3\u03b9 \u03b2\u03bb\u03b1\u03c3\u03c6\u03b7\u03bc\u03bf\u1fe6\u03c3\u03b9\u03bd, \u1f45\u03c3\u03b1 \u03b4\u1f72 \u03c6\u03c5\u03c3\u03b9\u03ba\u1ff6\u03c2 \u1f61\u03c2 \u03c4\u1f70 \u1f04\u03bb\u03bf\u03b3\u03b1 \u03b6\u1ff7\u03b1 \u1f10\u03c0\u03af\u03c3\u03c4\u03b1\u03bd\u03c4\u03b1\u03b9, \u1f10\u03bd \u03c4\u03bf\u03cd\u03c4\u03bf\u03b9\u03c2 \u03c6\u03b8\u03b5\u03af\u03c1\u03bf\u03bd\u03c4\u03b1\u03b9.",
      "11": "\u03bf\u1f50\u03b1\u1f76 \u03b1\u1f50\u03c4\u03bf\u1fd6\u03c2, \u1f45\u03c4\u03b9 \u03c4\u1fc7 \u1f41\u03b4\u1ff7 \u03c4\u03bf\u1fe6 \u039a\u03ac\u03ca\u03bd \u1f10\u03c0\u03bf\u03c1\u03b5\u03cd\u03b8\u03b7\u03c3\u03b1\u03bd, \u03ba\u03b1\u1f76 \u03c4\u1fc7 \u03c0\u03bb\u03ac\u03bd\u1fc3 \u03c4\u03bf\u1fe6 \u0392\u03b1\u03bb\u03b1\u1f70\u03bc \u03bc\u03b9\u03c3\u03b8\u03bf\u1fe6 \u1f10\u03be\u03b5\u03c7\u03cd\u03b8\u03b7\u03c3\u03b1\u03bd, \u03ba\u03b1\u1f76 \u03c4\u1fc7 \u1f00\u03bd\u03c4\u03b9\u03bb\u03bf\u03b3\u03af\u1fb3 \u03c4\u03bf\u1fe6 \u039a\u03bf\u03c1\u1f72 \u1f00\u03c0\u03ce\u03bb\u03bf\u03bd\u03c4\u03bf.",
      "12": "\u03bf\u1f57\u03c4\u03bf\u03af \u03b5\u1f30\u03c3\u03b9\u03bd \u2021 \u03b5\u03bd 85.7% \u00a6 \u03bf\u03b9 \u03b5\u03bd \u1d04\u1d1b 14.1% \u1f10\u03bd \u03c4\u03b1\u1fd6\u03c2 \u1f00\u03b3\u03ac\u03c0\u03b1\u03b9\u03c2 \u1f51\u03bc\u1ff6\u03bd \u03c3\u03c0\u03b9\u03bb\u03ac\u03b4\u03b5\u03c2, \u00a7 \u03c3\u03c5\u03bd\u03b5\u03c5\u03c9\u03c7\u03bf\u03c5\u03bc\u03b5\u03bd\u03bf\u03b9 83.6% \u00a6 \u03c3\u03c5\u03bd\u03b5\u03c5\u03c9\u03c7\u03bf\u03c5\u03bc\u03b5\u03bd\u03bf\u03b9 \u03c5\u03bc\u03b9\u03bd \ua731\u1d04\u0280 16.4% \u03c3\u03c5\u03bd\u03b5\u03c5\u03c9\u03c7\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf\u03b9 \u1f00\u03c6\u03cc\u03b2\u03c9\u03c2, \u1f11\u03b1\u03c5\u03c4\u03bf\u1f7a\u03c2 \u03c0\u03bf\u03b9\u03bc\u03b1\u03af\u03bd\u03bf\u03bd\u03c4\u03b5\u03c2\u00b7 \u03bd\u03b5\u03c6\u03ad\u03bb\u03b1\u03b9 \u1f04\u03bd\u03c5\u03b4\u03c1\u03bf\u03b9 \u1f51\u03c0\u1f78 \u1f00\u03bd\u03ad\u03bc\u03c9\u03bd * \u03c0\u03b1\u03c1\u03b1\u03c6\u03b5\u03c1\u03bf\u03bc\u03b5\u03bd\u03b1\u03b9 87.4% \u00a6 \u03c0\u03b5\u03c1\u03b9\u03c6\u03b5\u03c1\u03bf\u03bc\u03b5\u03bd\u03b1\u03b9 \u1d1b\u0280 4.7% \u03c0\u03b1\u03c1\u03b1\u03c6\u03b5\u03c1\u03cc\u03bc\u03b5\u03bd\u03b1\u03b9\u00b7 \u03b4\u03ad\u03bd\u03b4\u03c1\u03b1 \u03c6\u03b8\u03b9\u03bd\u03bf\u03c0\u03c9\u03c1\u03b9\u03bd\u03ac, \u1f04\u03ba\u03b1\u03c1\u03c0\u03b1, \u03b4\u1f76\u03c2 \u1f00\u03c0\u03bf\u03b8\u03b1\u03bd\u03cc\u03bd\u03c4\u03b1, \u1f10\u03ba\u03c1\u03b9\u03b6\u03c9\u03b8\u03ad\u03bd\u03c4\u03b1\u00b7",
      "13": "\u03ba\u03cd\u03bc\u03b1\u03c4\u03b1 \u1f04\u03b3\u03c1\u03b9\u03b1 \u03b8\u03b1\u03bb\u03ac\u03c3\u03c3\u03b7\u03c2 \u1f10\u03c0\u03b1\u03c6\u03c1\u03af\u03b6\u03bf\u03bd\u03c4\u03b1 \u03c4\u1f70\u03c2 \u1f11\u03b1\u03c5\u03c4\u1ff6\u03bd \u03b1\u1f30\u03c3\u03c7\u03cd\u03bd\u03b1\u03c2\u00b7 \u1f00\u03c3\u03c4\u03ad\u03c1\u03b5\u03c2 \u03c0\u03bb\u03b1\u03bd\u1fc6\u03c4\u03b1\u03b9, \u03bf\u1f37\u03c2 \u1f41 \u03b6\u03cc\u03c6\u03bf\u03c2 \u03c4\u03bf\u1fe6 \u03c3\u03ba\u03cc\u03c4\u03bf\u03c5\u03c2 \u03b5\u1f30\u03c2 \u2020 \u03c4\u03bf\u03bd \u03b1\u03b9\u03c9\u03bd\u03b1 37% \u00a6 \u03b1\u03b9\u03c9\u03bd\u03b1 \u1d04\u1d1b \u029c\ua730 \u1d18\u1d04\u1d0b \u0280\u1d18 54.6% \u00a6 \u03b1\u03b9\u03c9\u03bd\u03b1\u03c2 \u1d0d\ua731\ua731 7.9% \u03c4\u1f78\u03bd \u03b1\u1f30\u1ff6\u03bd\u03b1 \u03c4\u03b5\u03c4\u03ae\u03c1\u03b7\u03c4\u03b1\u03b9.",
      "14": "\u2021 \u03c0\u03c1\u03bf\u03b5\u03c6\u03b7\u03c4\u03b5\u03c5\u03c3\u03b5 97.4% \u00a6 \u03b5\u03c0\u03c1\u03bf\u03c6\u03b7\u03c4\u03b5\u03c5\u03c3\u03b5 \u1d21\u029c 0.4% \u03a0\u03c1\u03bf\u03b5\u03c6\u03ae\u03c4\u03b5\u03c5\u03c3\u03b5 \u03b4\u1f72 \u03ba\u03b1\u1f76 \u03c4\u03bf\u03cd\u03c4\u03bf\u03b9\u03c2 \u1f15\u03b2\u03b4\u03bf\u03bc\u03bf\u03c2 \u1f00\u03c0\u1f78 \u1f08\u03b4\u1f70\u03bc \u1f18\u03bd\u1f7c\u03c7 \u03bb\u03ad\u03b3\u03c9\u03bd, \u1f38\u03b4\u03bf\u03cd, \u1f26\u03bb\u03b8\u03b5 \u039a\u03cd\u03c1\u03b9\u03bf\u03c2 \u1f10\u03bd \u00a7 \u03b1\u03b3\u03b9\u03b1\u03b9\u03c2 \u03bc\u03c5\u03c1\u03b9\u03b1\u03c3\u03b9\u03bd 88.4% \u00a6 \u03bc\u03c5\u03c1\u03b9\u03b1\u03c3\u03b9\u03bd \u03b1\u03b3\u03b9\u03b1\u03b9\u03c2 \u1d1b\u0280 5.1% \u1f01\u03b3\u03af\u03b1\u03b9\u03c2 \u03bc\u03c5\u03c1\u03b9\u03ac\u03c3\u03b9\u03bd \u03b1\u1f50\u03c4\u03bf\u1fe6",
      "15": "\u03c0\u03bf\u03b9\u1fc6\u03c3\u03b1\u03b9 \u03ba\u03c1\u03af\u03c3\u03b9\u03bd \u03ba\u03b1\u03c4\u1f70 \u03c0\u03ac\u03bd\u03c4\u03c9\u03bd \u03ba\u03b1\u1f76 * \u03b5\u03bb\u03b5\u03b3\u03be\u03b1\u03b9 88% \u00a6 \u03b5\u03be\u03b5\u03bb\u03b5\u03b3\u03be\u03b1\u03b9 \u1d1b\u0280 10.2% \u1f10\u03bb\u03ad\u03b3\u03be\u03b1\u03b9 \u2020 \u03c0\u03b1\u03bd\u03c4\u03b1\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03b1\u03c3\u03b5\u03b2\u03b5\u03b9\u03c2 \u03b1\u03c5\u03c4\u03c9\u03bd 79.5% \u00a6 \u03c0\u03b1\u03bd\u03c4\u03b1\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03b1\u03c3\u03b5\u03b2\u03b5\u03b9\u03c2 \ua731\u0299\u029f \u1d1b\u029c \u1d21\u029c 15.8% \u00a6 \u03c0\u03b1\u03c3\u03b1\u03bd \u03c8\u03c5\u03c7\u03b7\u03bd \u0274\u1d00 0.6% \u03c0\u03ac\u03bd\u03c4\u03b1\u03c2 \u03c4\u03bf\u1f7a\u03c2 \u1f00\u03c3\u03b5\u03b2\u03b5\u1fd6\u03c2 \u03b1\u1f50\u03c4\u1ff6\u03bd \u03c0\u03b5\u03c1\u1f76 \u03c0\u03ac\u03bd\u03c4\u03c9\u03bd \u03c4\u1ff6\u03bd \u1f14\u03c1\u03b3\u03c9\u03bd \u1f00\u03c3\u03b5\u03b2\u03b5\u03af\u03b1\u03c2 \u03b1\u1f50\u03c4\u1ff6\u03bd \u1f67\u03bd \u1f20\u03c3\u03ad\u03b2\u03b7\u03c3\u03b1\u03bd \u03ba\u03b1\u1f76 \u03c0\u03b5\u03c1\u1f76 \u03c0\u03ac\u03bd\u03c4\u03c9\u03bd \u03c4\u1ff6\u03bd \u03c3\u03ba\u03bb\u03b7\u03c1\u1ff6\u03bd \u1f67\u03bd \u1f10\u03bb\u03ac\u03bb\u03b7\u03c3\u03b1\u03bd \u03ba\u03b1\u03c4\u1fbd \u03b1\u1f50\u03c4\u03bf\u1fe6 \u1f01\u03bc\u03b1\u03c1\u03c4\u03c9\u03bb\u03bf\u1f76 \u1f00\u03c3\u03b5\u03b2\u03b5\u1fd6\u03c2.",
      "16": "\u03bf\u1f57\u03c4\u03bf\u03af \u03b5\u1f30\u03c3\u03b9 \u03b3\u03bf\u03b3\u03b3\u03c5\u03c3\u03c4\u03b1\u03af, \u03bc\u03b5\u03bc\u03c8\u03af\u03bc\u03bf\u03b9\u03c1\u03bf\u03b9, \u03ba\u03b1\u03c4\u1f70 \u03c4\u1f70\u03c2 \u1f10\u03c0\u03b9\u03b8\u03c5\u03bc\u03af\u03b1\u03c2 \u2021 \u03b1\u03c5\u03c4\u03c9\u03bd 48.3% \u00a6 \u03b5\u03b1\u03c5\u03c4\u03c9\u03bd \u0274\u1d00 \u1d18\u1d04\u1d0b 47.2% \u03b1\u1f50\u03c4\u1ff6\u03bd \u03c0\u03bf\u03c1\u03b5\u03c5\u03cc\u03bc\u03b5\u03bd\u03bf\u03b9, \u03ba\u03b1\u1f76 \u03c4\u1f78 \u03c3\u03c4\u03cc\u03bc\u03b1 \u03b1\u1f50\u03c4\u1ff6\u03bd \u03bb\u03b1\u03bb\u03b5\u1fd6 \u1f51\u03c0\u03ad\u03c1\u03bf\u03b3\u03ba\u03b1, \u03b8\u03b1\u03c5\u03bc\u03ac\u03b6\u03bf\u03bd\u03c4\u03b5\u03c2 \u03c0\u03c1\u03cc\u03c3\u03c9\u03c0\u03b1 \u00a7 \u03c9\u03c6\u03b5\u03bb\u03b5\u03b9\u03b1\u03c2 \u00a6 \u03c9\u03c6\u03b5\u03bb\u03b9\u03b1\u03c2 \u1d21\u029c \u1f60\u03c6\u03b5\u03bb\u03b5\u03af\u03b1\u03c2 \u03c7\u03ac\u03c1\u03b9\u03bd.",
      "17": "\u1f59\u03bc\u03b5\u1fd6\u03c2 \u03b4\u03ad, \u1f00\u03b3\u03b1\u03c0\u03b7\u03c4\u03bf\u03af, \u03bc\u03bd\u03ae\u03c3\u03b8\u03b7\u03c4\u03b5 \u03c4\u1ff6\u03bd \u1fe5\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u03c4\u1ff6\u03bd \u03c0\u03c1\u03bf\u03b5\u03b9\u03c1\u03b7\u03bc\u03ad\u03bd\u03c9\u03bd \u1f51\u03c0\u1f78 \u03c4\u1ff6\u03bd \u1f00\u03c0\u03bf\u03c3\u03c4\u03cc\u03bb\u03c9\u03bd \u03c4\u03bf\u1fe6 \u039a\u03c5\u03c1\u03af\u03bf\u03c5 \u1f21\u03bc\u1ff6\u03bd \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6,",
      "18": "\u1f45\u03c4\u03b9 \u1f14\u03bb\u03b5\u03b3\u03bf\u03bd \u1f51\u03bc\u1fd6\u03bd * \u03bf\u03c4\u03b9 98.5% \u00a6 \u2014 \u0274\u1d00 \ua731\u0299\u029f \u1d21\u029c 1.5% \u1f45\u03c4\u03b9 \u2020 \u03b5\u03bd \u03b5\u03c3\u03c7\u03b1\u03c4\u03c9 \u03c7\u03c1\u03bf\u03bd\u03c9 77.8% \u00a6 \u03b5\u03c0 \u03b5\u03c3\u03c7\u03b1\u03c4\u03c9\u03bd \u03c4\u03c9\u03bd \u03c7\u03c1\u03bf\u03bd\u03c9\u03bd \u1d0d\ua731\ua731 5.4% \u00a6 \u03b5\u03c0 \u03b5\u03c3\u03c7\u03b1\u03c4\u03bf\u03c5 \u03c7\u03c1\u03bf\u03bd\u03bf\u03c5 \u1d04\u1d1b 1.4% \u1f10\u03bd \u1f10\u03c3\u03c7\u03ac\u03c4\u1ff3 \u03c7\u03c1\u03cc\u03bd\u1ff3 \u1f14\u03c3\u03bf\u03bd\u03c4\u03b1\u03b9 \u1f10\u03bc\u03c0\u03b1\u1fd6\u03ba\u03c4\u03b1\u03b9 \u03ba\u03b1\u03c4\u1f70 \u03c4\u1f70\u03c2 \u1f11\u03b1\u03c5\u03c4\u1ff6\u03bd \u1f10\u03c0\u03b9\u03b8\u03c5\u03bc\u03af\u03b1\u03c2 \u03c0\u03bf\u03c1\u03b5\u03c5\u03cc\u03bc\u03b5\u03bd\u03bf\u03b9 \u03c4\u1ff6\u03bd \u1f00\u03c3\u03b5\u03b2\u03b5\u03b9\u1ff6\u03bd.",
      "19": "\u03bf\u1f57\u03c4\u03bf\u03af \u03b5\u1f30\u03c3\u03b9\u03bd \u03bf\u1f31 \u2021 \u03b1\u03c0\u03bf\u03b4\u03b9\u03bf\u03c1\u03b9\u03b6\u03bf\u03bd\u03c4\u03b5\u03c2 77.5% \u00a6 \u03b1\u03c0\u03bf\u03b4\u03b9\u03bf\u03c1\u03b9\u03b6\u03bf\u03bd\u03c4\u03b5\u03c2 \u03b5\u03b1\u03c5\u03c4\u03bf\u03c5\u03c2 \ua731\u1d04\u0280 20.8% \u1f00\u03c0\u03bf\u03b4\u03b9\u03bf\u03c1\u03af\u03b6\u03bf\u03bd\u03c4\u03b5\u03c2, \u03c8\u03c5\u03c7\u03b9\u03ba\u03bf\u03af, \u03a0\u03bd\u03b5\u1fe6\u03bc\u03b1 \u03bc\u1f74 \u1f14\u03c7\u03bf\u03bd\u03c4\u03b5\u03c2.",
      "20": "\u1f21\u03bc\u03b5\u1fd6\u03c2 \u03b4\u03ad, \u1f00\u03b3\u03b1\u03c0\u03b7\u03c4\u03bf\u03af, \u00a7 \u03c4\u03b7 \u03b1\u03b3\u03b9\u03c9\u03c4\u03b1\u03c4\u03b7 \u03c5\u03bc\u03c9\u03bd \u03c0\u03b9\u03c3\u03c4\u03b5\u03b9 \u03b5\u03c0\u03bf\u03b9\u03ba\u03bf\u03b4\u03bf\u03bc\u03bf\u03c5\u03bd\u03c4\u03b5\u03c2 \u03b5\u03b1\u03c5\u03c4\u03bf\u03c5\u03c2 78% \u00a6 \u03b5\u03c0\u03bf\u03b9\u03ba\u03bf\u03b4\u03bf\u03bc\u03bf\u03c5\u03bd\u03c4\u03b5\u03c2 \u03b5\u03b1\u03c5\u03c4\u03bf\u03c5\u03c2 \u03c4\u03b7 \u03b1\u03b3\u03b9\u03c9\u03c4\u03b1\u03c4\u03b7 \u03c5\u03bc\u03c9\u03bd \u03c0\u03b9\u03c3\u03c4\u03b5\u03b9 \u1d04\u1d1b 9.5% \u00a6 \u03c4\u03b7 \u03b1\u03b3\u03b9\u03c9\u03c4\u03b1\u03c4\u03b7 \u03b7\u03bc\u03c9\u03bd \u03c0\u03b9\u03c3\u03c4\u03b5\u03b9 \u03b5\u03c0\u03bf\u03b9\u03ba\u03bf\u03b4\u03bf\u03bc\u03bf\u03c5\u03bd\u03c4\u03b5\u03c2 \u03b5\u03b1\u03c5\u03c4\u03bf\u03c5\u03c2 \u1d0d\ua731\ua731 6.2% \u03c4\u1fc7 \u1f01\u03b3\u03b9\u03c9\u03c4\u03ac\u03c4\u1fc3 \u1f51\u03bc\u1ff6\u03bd \u03c0\u03af\u03c3\u03c4\u03b5\u03b9 \u1f10\u03c0\u03bf\u03b9\u03ba\u03bf\u03b4\u03bf\u03bc\u03bf\u1fe6\u03bd\u03c4\u03b5\u03c2 \u1f11\u03b1\u03c5\u03c4\u03bf\u03cd\u03c2, \u1f10\u03bd \u03a0\u03bd\u03b5\u03cd\u03bc\u03b1\u03c4\u03b9 \u1f09\u03b3\u03af\u1ff3 \u03c0\u03c1\u03bf\u03c3\u03b5\u03c5\u03c7\u03cc\u03bc\u03b5\u03bd\u03bf\u03b9,",
      "21": "\u1f11\u03b1\u03c5\u03c4\u03bf\u1f7a\u03c2 \u1f10\u03bd \u1f00\u03b3\u03ac\u03c0\u1fc3 \u0398\u03b5\u03bf\u1fe6 \u03c4\u03b7\u03c1\u03ae\u03c3\u03b1\u03c4\u03b5 \u03c0\u03c1\u03bf\u03c3\u03b4\u03b5\u03c7\u03cc\u03bc\u03b5\u03bd\u03bf\u03b9 \u03c4\u1f78 \u1f14\u03bb\u03b5\u03bf\u03c2 \u03c4\u03bf\u1fe6 \u039a\u03c5\u03c1\u03af\u03bf\u03c5 \u1f21\u03bc\u1ff6\u03bd \u1f38\u03b7\u03c3\u03bf\u1fe6 \u03a7\u03c1\u03b9\u03c3\u03c4\u03bf\u1fe6 \u03b5\u1f30\u03c2 \u03b6\u03c9\u1f74\u03bd \u03b1\u1f30\u03ce\u03bd\u03b9\u03bf\u03bd.",
      "22": "\u03ba\u03b1\u1f76 \u03bf\u1f53\u03c2 \u03bc\u1f72\u03bd * \u03b5\u03bb\u03b5\u03b5\u03b9\u03c4\u03b5 \u03b4\u03b9\u03b1\u03ba\u03c1\u03b9\u03bd\u03bf\u03bc\u03b5\u03bd\u03bf\u03b9 88% \u00a6 \u03b5\u03bb\u03b5\u03b3\u03c7\u03b5\u03c4\u03b5 \u03b4\u03b9\u03b1\u03ba\u03c1\u03b9\u03bd\u03bf\u03bc\u03b5\u03bd\u03bf\u03c5\u03c2 \u1d1b\u029c 6.9% \u00a6 \u03b5\u03bb\u03b5\u03b1\u03c4\u03b5 \u03b4\u03b9\u03b1\u03ba\u03c1\u03b9\u03bd\u03bf\u03bc\u03b5\u03bd\u03bf\u03c5\u03c2 \u0274\u1d00 \ua731\u0299\u029f \u1d21\u029c 2.1% \u1f10\u03bb\u03b5\u03b5\u1fd6\u03c4\u03b5 \u03b4\u03b9\u03b1\u03ba\u03c1\u03b9\u03bd\u03cc\u03bc\u03b5\u03bd\u03bf\u03b9,",
      "23": "\u2020 \u03bf\u03c5\u03c2 \u03b4\u03b5 \u03b5\u03bd \u03c6\u03bf\u03b2\u03c9 \u03c3\u03c9\u03b6\u03b5\u03c4\u03b5 \u03b5\u03ba \u03c0\u03c5\u03c1\u03bf\u03c2 \u03b1\u03c1\u03c0\u03b1\u03b6\u03bf\u03bd\u03c4\u03b5\u03c2 66.9% \u00a6 \u03bf\u03c5\u03c2 \u03b4\u03b5 \u03b5\u03bd \u03c6\u03bf\u03b2\u03c9 \u03c3\u03c9\u03b6\u03b5\u03c4\u03b5 \u03b5\u03ba \u03c4\u03bf\u03c5 \u03c0\u03c5\u03c1\u03bf\u03c2 \u03b1\u03c1\u03c0\u03b1\u03b6\u03bf\u03bd\u03c4\u03b5\u03c2 \u1d00\u0274\u1d1b \u1d1b\u0280 8% \u00a6 \u03bf\u03c5\u03c2 \u03b4\u03b5 \u03c3\u03c9\u03b6\u03b5\u03c4\u03b5 \u03b5\u03ba \u03c0\u03c5\u03c1\u03bf\u03c2 \u03b1\u03c1\u03c0\u03b1\u03b6\u03bf\u03bd\u03c4\u03b5\u03c2 \u03bf\u03c5\u03c2 \u03b4\u03b5 \u03b5\u03bb\u03b5\u03b1\u03c4\u03b5 \u03b5\u03bd \u03c6\u03bf\u03b2\u03c9 \u0274\u1d00 \ua731\u0299\u029f \u1d1b\u029c 5% \u00a6 \u03c3\u03c9\u03b6\u03b5\u03c4\u03b5 \u03b5\u03ba \u03c0\u03c5\u03c1\u03bf\u03c2 \u03b1\u03c1\u03c0\u03b1\u03b6\u03bf\u03bd\u03c4\u03b5\u03c2 \u03bf\u03c5\u03c2 \u03b4\u03b5 \u03b5\u03bb\u03b5\u03b1\u03c4\u03b5 \u03b5\u03bd \u03c6\u03bf\u03b2\u03c9 \u1d21\u029c 0.2% \u03bf\u1f53\u03c2 \u03b4\u1f72 \u1f10\u03bd \u03c6\u03cc\u03b2\u1ff3 \u03c3\u1ff4\u03b6\u03b5\u03c4\u03b5, \u1f10\u03ba \u03c0\u03c5\u03c1\u1f78\u03c2 \u1f01\u03c1\u03c0\u03ac\u03b6\u03bf\u03bd\u03c4\u03b5\u03c2, \u03bc\u03b9\u03c3\u03bf\u1fe6\u03bd\u03c4\u03b5\u03c2 \u03ba\u03b1\u1f76 \u03c4\u1f78\u03bd \u1f00\u03c0\u1f78 \u03c4\u1fc6\u03c2 \u03c3\u03b1\u03c1\u03ba\u1f78\u03c2 \u1f10\u03c3\u03c0\u03b9\u03bb\u03c9\u03bc\u03ad\u03bd\u03bf\u03bd \u03c7\u03b9\u03c4\u1ff6\u03bd\u03b1.",
      "24": "\u03a4\u1ff7 \u03b4\u1f72 \u03b4\u03c5\u03bd\u03b1\u03bc\u03ad\u03bd\u1ff3 \u03c6\u03c5\u03bb\u03ac\u03be\u03b1\u03b9 \u2021 \u03b1\u03c5\u03c4\u03bf\u03c5\u03c2 \u03b1\u03c0\u03c4\u03b1\u03b9\u03c3\u03c4\u03bf\u03c5\u03c2 63% \u00a6 \u03c5\u03bc\u03b1\u03c2 \u03b1\u03c0\u03c4\u03b1\u03b9\u03c3\u03c4\u03bf\u03c5\u03c2 \u1d04\u1d1b \ua731\u1d04\u0280 21.9% \u00a6 \u03c5\u03bc\u03b1\u03c2 \u03b1\u03c0\u03c4\u03b1\u03b9\u03c3\u03c4\u03bf\u03c5\u03c2 \u03ba\u03b1\u03b9 \u03b1\u03c3\u03c0\u03b9\u03bb\u03bf\u03c5\u03c2 \u1d0d\ua731\ua731 7.4% \u03b1\u1f50\u03c4\u03bf\u1f7a\u03c2 \u1f00\u03c0\u03c4\u03b1\u03af\u03c3\u03c4\u03bf\u03c5\u03c2 \u03ba\u03b1\u1f76 \u03c3\u03c4\u1fc6\u03c3\u03b1\u03b9 \u03ba\u03b1\u03c4\u03b5\u03bd\u03ce\u03c0\u03b9\u03bf\u03bd \u03c4\u1fc6\u03c2 \u03b4\u03cc\u03be\u03b7\u03c2 \u03b1\u1f50\u03c4\u03bf\u1fe6 \u1f00\u03bc\u03ce\u03bc\u03bf\u03c5\u03c2 \u1f10\u03bd \u1f00\u03b3\u03b1\u03bb\u03bb\u03b9\u03ac\u03c3\u03b5\u03b9,",
      "25": "\u03bc\u03cc\u03bd\u1ff3 \u00a7 \u03c3\u03bf\u03c6\u03c9 \u03b8\u03b5\u03c9 82.3% \u00a6 \u03b8\u03b5\u03c9 \u1d04\u1d1b 7.4% \u00a6 \u03c3\u03bf\u03c6\u03c9 \u1d0d\ua731\ua731 5.5% \u03c3\u03bf\u03c6\u1ff7 \u0398\u03b5\u1ff7 \u03c3\u03c9\u03c4\u1fc6\u03c1\u03b9 * \u03b7\u03bc\u03c9\u03bd 77.9% \u00a6 \u03b7\u03bc\u03c9\u03bd \u03b4\u03b9\u03b1 \u03b9\u03b7\u03c3\u03bf\u03c5 \u03c7\u03c1\u03b9\u03c3\u03c4\u03bf\u03c5 \u03c4\u03bf\u03c5 \u03ba\u03c5\u03c1\u03b9\u03bf\u03c5 \u03b7\u03bc\u03c9\u03bd \u1d04\u1d1b 21.1% \u1f21\u03bc\u1ff6\u03bd, \u03b4\u03cc\u03be\u03b1 \u2020 \u03ba\u03b1\u03b9 86.4% \u00a6 \u2014 \u1d04\u1d1b 11.2% \u03ba\u03b1\u1f76 \u03bc\u03b5\u03b3\u03b1\u03bb\u03c9\u03c3\u03cd\u03bd\u03b7, \u03ba\u03c1\u03ac\u03c4\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f10\u03be\u03bf\u03c5\u03c3\u03af\u03b1, \u2021 \u03ba\u03b1\u03b9 78.4% \u00a6 \u03c0\u03c1\u03bf \u03c0\u03b1\u03bd\u03c4\u03bf\u03c2 \u03c4\u03bf\u03c5 \u03b1\u03b9\u03c9\u03bd\u03bf\u03c2 \u03ba\u03b1\u03b9 \u1d04\u1d1b 13.2% \u00a6 \u03c0\u03c1\u03bf \u03c0\u03b1\u03bd\u03c4\u03bf\u03c2 \u03b1\u03b9\u03c9\u03bd\u03bf\u03c2 \u03ba\u03b1\u03b9 \u1d0d\ua731\ua731 8.2% \u03ba\u03b1\u1f76 \u03bd\u1fe6\u03bd \u03ba\u03b1\u1f76 \u03b5\u1f30\u03c2 \u03c0\u03ac\u03bd\u03c4\u03b1\u03c2 \u03c4\u03bf\u1f7a\u03c2 \u03b1\u1f30\u1ff6\u03bd\u03b1\u03c2."
    }
  }
}